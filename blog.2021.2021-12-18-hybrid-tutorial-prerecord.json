tween lecture-style talking and going through steps yourself to make sure that you’re not out-pacing the attendees.","position":{"start":{"line":17,"column":1},"end":{"line":17,"column":1}},"key":"yhWw35SU8R"}],"key":"oTfelbUvxH"}],"key":"bKxX4Pb2qv"},{"type":"listItem","spread":true,"position":{"start":{"line":18,"column":1},"end":{"line":19,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"My time working with ","position":{"start":{"line":18,"column":1},"end":{"line":18,"column":1}},"key":"OGXyOOwhhX"},{"type":"link","url":"https://carpentries.org/","position":{"start":{"line":18,"column":1},"end":{"line":18,"column":1}},"children":[{"type":"text","value":"the Carpentries","position":{"start":{"line":18,"column":1},"end":{"line":18,"column":1}},"key":"HuKgXWmrVM"}],"urlSource":"https://carpentries.org/","key":"IUTOWowTxT"},{"type":"text","value":" taught me that having helpers in a tutorial is extremely useful to keep things on track.","position":{"start":{"line":18,"column":1},"end":{"line":18,"column":1}},"key":"Fz82GIQhBS"}],"key":"g9A0IWrnIW"}],"key":"lQA7HfnSWy"}],"key":"nwbRuhPyZv"},{"type":"paragraph","position":{"start":{"line":20,"column":1},"end":{"line":20,"column":1}},"children":[{"type":"text","value":"So, I decided to try an expriment this time: I’d pre-record my tutorial via Zoom, and then attend the session as a helper. The rest of this post is about my experience!","position":{"start":{"line":20,"column":1},"end":{"line":20,"column":1}},"key":"JSr5VR7S08"}],"key":"hD8uanF26W"},{"type":"admonition","children":[{"type":"admonitionTitle","children":[{"type":"text","value":"If you’d like to check out the tutorial","position":{"start":{"line":22,"column":1},"end":{"line":22,"column":1}},"key":"AWJqIhxrN5"}],"key":"MMxGSElMok"},{"type":"paragraph","position":{"start":{"line":24,"column":1},"end":{"line":24,"column":1}},"children":[{"type":"text","value":"Here’s a video of the tutorial in case you’re interested!","position":{"start":{"line":24,"column":1},"end":{"line":24,"column":1}},"key":"j5yDpkoruo"}],"key":"W8KizRPbtm"},{"type":"iframe","src":"https://www.youtube.com/embed/lZ2FHTkyaMU","width":"100%","title":"YouTube video player","key":"jaNSmlbamB"}],"key":"S6SVOy2ztV"},{"type":"heading","depth":2,"position":{"start":{"line":30,"column":1},"end":{"line":30,"column":1}},"children":[{"type":"text","value":"An experiment: record myself ahead of time","position":{"start":{"line":30,"column":1},"end":{"line":30,"column":1}},"key":"Im612aKCOz"}],"identifier":"an-experiment-record-myself-ahead-of-time","label":"An experiment: record myself ahead of time","html_id":"an-experiment-record-myself-ahead-of-time","implicit":true,"key":"Yhu6iYRgiL"},{"type":"paragraph","position":{"start":{"line":32,"column":1},"end":{"line":32,"column":1}},"children":[{"type":"text","value":"Here’s what I did:","position":{"start":{"line":32,"column":1},"end":{"line":32,"column":1}},"key":"TaTtYfQ3F0"}],"key":"JNHCP45tef"},{"type":"heading","depth":3,"position":{"start":{"line":34,"column":1},"end":{"line":34,"column":1}},"children":[{"type":"text","value":"Before the session","position":{"start":{"line":34,"column":1},"end":{"line":34,"column":1}},"key":"eDsEuCsGXe"}],"identifier":"before-the-session","label":"Before the session","html_id":"before-the-session","implicit":true,"key":"JeXhkrePSu"},{"type":"list","ordered":true,"start":1,"spread":false,"position":{"start":{"line":36,"column":1},"end":{"line":54,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":36,"column":1},"end":{"line":43,"column":1}},"children":[{"type":"paragraph","position":{"start":{"line":36,"column":1},"end":{"line":36,"column":1}},"children":[{"type":"text","value":"Opened two windows on my screen on top of each other: one window was a Google Slides window with my presentation, the other was a JupyterLab window that I used to demonstrate all of the steps.","position":{"start":{"line":36,"column":1},"end":{"line":36,"column":1}},"key":"HiR0PMpPFH"}],"key":"ICjkzAJES5"},{"type":"paragraph","position":{"start":{"line":38,"column":1},"end":{"line":38,"column":1}},"children":[{"type":"text","value":"Here’s how it looked:","position":{"start":{"line":38,"column":1},"end":{"line":38,"column":1}},"key":"fDnv7gnUqy"}],"key":"C0un0rpRKL"},{"type":"container","kind":"figure","children":[{"type":"image","url":"/build/9c5f30a4a04a0ddea887b8cfbfca92ce.png","alt":"My two-window setup in recording the tutorial.","data":{"altTextIsAutoGenerated":true},"key":"WTW5bWZo8l","urlSource":"https://user-images.githubusercontent.com/1839645/146656769-95e0e430-15ac-4b5e-a0ee-7e77e8f7b9ed.png"},{"type":"caption","children":[{"type":"paragraph","position":{"start":{"line":42,"column":1},"end":{"line":42,"column":1}},"children":[{"type":"text","value":"My two-window setup in recording the tutorial.","position":{"start":{"line":42,"column":1},"end":{"line":42,"column":1}},"key":"WIzPTTgUpb"}],"key":"FArE9fRj2A"}],"key":"CXupswSBIA"}],"enumerator":"1","key":"NPKT14974H"}],"key":"HsUWA6LmUO"},{"type":"listItem","spread":true,"position":{"start":{"line":44,"column":1},"end":{"line":49,"column":1}},"children":[{"type":"paragraph","position":{"start":{"line":44,"column":1},"end":{"line":44,"column":1}},"children":[{"type":"text","value":"In my slides, I included several prompts with explicit text for people to type into their own terminals and text files. I followed the instructions in these slides and typed them into the JupyterLab window myself.","position":{"start":{"line":44,"column":1},"end":{"line":44,"column":1}},"key":"g6sncTBJnu"}],"key":"Amdsj5CSPU"},{"type":"container","kind":"figure","children":[{"type":"image","url":"/build/57cb78565e2ef0b7f38641de77baf7c7.png","alt":"Instructions on the top, real-time results on the bottom.","data":{"altTextIsAutoGenerated":true},"key":"AIF829H8vo","urlSource":"https://user-images.githubusercontent.com/1839645/146656866-0236e791-9a16-4c60-aa0b-e1ea99e46dd5.png"},{"type":"caption","children":[{"type":"paragraph","position":{"start":{"line":47,"column":1},"end":{"line":47,"column":1}},"children":[{"type":"text","value":"Instructions on the top, real-time results on the bottom.","position":{"start":{"line":47,"column":1},"end":{"line":47,"column":1}},"key":"wAXWkEErCm"}],"key":"wVYZAQAEBP"}],"key":"rK5dvYPcTx"}],"enumerator":"2","key":"OWUWSL63oq"}],"key":"YCJuNg6KGp"},{"type":"listItem","spread":true,"position":{"start":{"line":50,"column":1},"end":{"line":50,"column":1}},"children":[{"type":"paragraph","position":{"start":{"line":50,"column":1},"end":{"line":50,"column":1}},"children":[{"type":"text","value":"I used Zoom to record myself as I clicked through the slides on the top, and followed along on the bottom as if I were a participant myself.","position":{"start":{"line":50,"column":1},"end":{"line":50,"column":1}},"key":"J2Q3enpbCA"}],"key":"cDqxUBBILb"}],"key":"SeFuuoEtEM"},{"type":"listItem","spread":true,"position":{"start":{"line":51,"column":1},"end":{"line":52,"column":1}},"children":[{"type":"paragraph","position":{"start":{"line":51,"column":1},"end":{"line":52,"column":1}},"children":[{"type":"text","value":"I split the recording into roughly ","position":{"start":{"line":51,"column":1},"end":{"line":51,"column":1}},"key":"O3BkA04ANK"},{"type":"strong","position":{"start":{"line":51,"column":1},"end":{"line":51,"column":1}},"children":[{"type":"text","value":"5 minute sections","position":{"start":{"line":51,"column":1},"end":{"line":51,"column":1}},"key":"i82EO2EJkB"}],"key":"McvKwKS2DP"},{"type":"text","value":".\nI’d stop the recording briefly for each section, take a quick breather, and then move on to recording the next. This ensured that I had a moment to collect myself and if I messed up a section, I’d only have to re-record 5 minutes instead of 30.","position":{"start":{"line":51,"column":1},"end":{"line":51,"column":1}},"key":"cKlvM6t0BL"}],"key":"YfDUPSWmP1"}],"key":"HWeMz0Hgmo"},{"type":"listItem","spread":true,"position":{"start":{"line":53,"column":1},"end":{"line":54,"column":1}},"children":[{"type":"paragraph","position":{"start":{"line":53,"column":1},"end":{"line":53,"column":1}},"children":[{"type":"text","value":"After the recording, I stitched together each of the sections and did a simple fade-out / fade-in using the built-in ","position":{"start":{"line":53,"column":1},"end":{"line":53,"column":1}},"key":"jx5cIvMhqR"},{"type":"link","url":"https://support.microsoft.com/en-us/windows/create-films-with-video-editor-94e651f8-a5be-ae03-3c50-e49f013d47f6","position":{"start":{"line":53,"column":1},"end":{"line":53,"column":1}},"children":[{"type":"text","value":"Windows Video Editor","position":{"start":{"line":53,"column":1},"end":{"line":53,"column":1}},"key":"rR5vYZXHLv"}],"urlSource":"https://support.microsoft.com/en-us/windows/create-films-with-video-editor-94e651f8-a5be-ae03-3c50-e49f013d47f6","key":"BTvqmKaqQ9"},{"type":"text","value":".","position":{"start":{"line":53,"column":1},"end":{"line":53,"column":1}},"key":"TARcSGAOTh"}],"key":"BA5Goi2ynM"}],"key":"MOpdBkuxhD"}],"key":"r14HDOHGKb"},{"type":"heading","depth":3,"position":{"start":{"line":55,"column":1},"end":{"line":55,"column":1}},"children":[{"type":"text","value":"During the session","position":{"start":{"line":55,"column":1},"end":{"line":55,"column":1}},"key":"STraVaRqny"}],"identifier":"during-the-session","label":"During the session","html_id":"during-the-session","implicit":true,"key":"GEqlGNn1YA"},{"type":"paragraph","position":{"start":{"line":57,"column":1},"end":{"line":60,"column":1}},"children":[{"type":"text","value":"During the tutorial, I played the pre-recorded video as the “presenter”, but spent my time answering questions and addressing issues via the chat box.\nAttendees would watch the pre-recorded video, and speak with me in the chat if anything came up.\nThis meant that I could address questions in real-time but without breaking up the flow of the tutorial.\nIf there was a really important question that was worth discussing as a group, I could have stopped the video to bring it up with everyone.","position":{"start":{"line":57,"column":1},"end":{"line":57,"column":1}},"key":"NADHRVUgbI"}],"key":"W8ct8tIpua"},{"type":"heading","depth":2,"position":{"start":{"line":62,"column":1},"end":{"line":62,"column":1}},"children":[{"type":"text","value":"Thoughts","position":{"start":{"line":62,"column":1},"end":{"line":62,"column":1}},"key":"MvTP4vlVWS"}],"identifier":"thoughts","label":"Thoughts","html_id":"thoughts","implicit":true,"key":"msI9gEpQmR"},{"type":"paragraph","position":{"start":{"line":64,"column":1},"end":{"line":66,"column":1}},"children":[{"type":"text","value":"In all, this worked really nicely!\nThe biggest downside is that it took a bit of extra time to pre-record the video before the talk itself.\nHowever, I believe I might have actually ","position":{"start":{"line":64,"column":1},"end":{"line":64,"column":1}},"key":"zRp6bdwpmb"},{"type":"emphasis","position":{"start":{"line":64,"column":1},"end":{"line":64,"column":1}},"children":[{"type":"text","value":"saved","position":{"start":{"line":64,"column":1},"end":{"line":64,"column":1}},"key":"GuQj9QndAj"}],"key":"zkVNITVS6s"},{"type":"text","value":" time, because pre-recording the talk meant that I didn’t feel the need to tinker with my slides in the hours leading up to the talk.","position":{"start":{"line":64,"column":1},"end":{"line":64,"column":1}},"key":"fHaOYiLSBg"}],"key":"rgLUM1mURu"},{"type":"paragraph","position":{"start":{"line":68,"column":1},"end":{"line":68,"column":1}},"children":[{"type":"text","value":"Here are some of the benefits that I noticed:","position":{"start":{"line":68,"column":1},"end":{"line":68,"column":1}},"key":"hsYCSnpQLk"}],"key":"DLXnWnDVKO"},{"type":"list","ordered":false,"spread":false,"position":{"start":{"line":70,"column":1},"end":{"line":74,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":70,"column":1},"end":{"line":70,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"I could serve as presenter and assistant in one talk - two roles with one person!","position":{"start":{"line":70,"column":1},"end":{"line":70,"column":1}},"key":"wzjLgPDCfY"}],"key":"KvPiJqrBuc"}],"key":"Q3PuwAuRhx"},{"type":"listItem","spread":true,"position":{"start":{"line":71,"column":1},"end":{"line":71,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"It gave me more control over the talk length and pacing, because I ","position":{"start":{"line":71,"column":1},"end":{"line":71,"column":1}},"key":"NKJR1vVf1p"},{"type":"emphasis","position":{"start":{"line":71,"column":1},"end":{"line":71,"column":1}},"children":[{"type":"text","value":"knew","position":{"start":{"line":71,"column":1},"end":{"line":71,"column":1}},"key":"QQcCwOIMK5"}],"key":"zmm9Ei2geD"},{"type":"text","value":" how much total time was there.","position":{"start":{"line":71,"column":1},"end":{"line":71,"column":1}},"key":"PZtk7mHQgI"}],"key":"FnpbooTqTw"}],"key":"hUFdQG6DeW"},{"type":"listItem","spread":true,"position":{"start":{"line":72,"column":1},"end":{"line":72,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"By recording it ahead of time, I was “done” with the talk much earlier than I normally am (usually I’m stressing about slides until a few moments before the talk)","position":{"start":{"line":72,"column":1},"end":{"line":72,"column":1}},"key":"F73jnxv8Jg"}],"key":"eeDjSheOXa"}],"key":"Zr09mH8zuJ"},{"type":"listItem","spread":true,"position":{"start":{"line":73,"column":1},"end":{"line":74,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"It also meant I had less anxiety before the event itself.","position":{"start":{"line":73,"column":1},"end":{"line":73,"column":1}},"key":"XnPOmugQOA"}],"key":"q1FpnMzZ9o"}],"key":"zHG3RgPgym"}],"key":"GBsXkU0aTS"},{"type":"paragraph","position":{"start":{"line":75,"column":1},"end":{"line":76,"column":1}},"children":[{"type":"text","value":"I’ll give this another shot the next time I’m giving a remote tutorial (or maybe an in-person tutorial by myself).\nIn the meantime, I wanted to write up these thoughts while they were fresh in case this might work for somebody else.","position":{"start":{"line":75,"column":1},"end":{"line":75,"column":1}},"key":"w84UT9zg5u"}],"key":"c5vMJU44Do"}],"key":"SN9sMQHdCW"}],"key":"Ee282rVheb"},"references":{"cite":{"order":[],"data":{}}},"footer":{"navigation":{"prev":{"title":"How to update Sphinx options during the build","url":"/blog/2022/sphinx-update-config","group":"2022"},"next":{"title":"What do people think about rST?","url":"/blog/2020/2020-01-22-rst-thoughts","group":"2020"}}},"domain":"http://localhost:3000"}