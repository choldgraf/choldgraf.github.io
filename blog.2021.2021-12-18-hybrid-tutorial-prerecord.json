tween lecture-style talking and going through steps yourself to make sure that you’re not out-pacing the attendees.","position":{"start":{"line":17,"column":1},"end":{"line":17,"column":1}},"key":"s66sO1c64Q"}],"key":"fXJzltJTW4"}],"key":"mw4Un34Gv8"},{"type":"listItem","spread":true,"position":{"start":{"line":18,"column":1},"end":{"line":19,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"My time working with ","position":{"start":{"line":18,"column":1},"end":{"line":18,"column":1}},"key":"sLtfRe9jxc"},{"type":"link","url":"https://carpentries.org/","position":{"start":{"line":18,"column":1},"end":{"line":18,"column":1}},"children":[{"type":"text","value":"the Carpentries","position":{"start":{"line":18,"column":1},"end":{"line":18,"column":1}},"key":"o5yVzlxqSa"}],"urlSource":"https://carpentries.org/","key":"s6EgUtgNpp"},{"type":"text","value":" taught me that having helpers in a tutorial is extremely useful to keep things on track.","position":{"start":{"line":18,"column":1},"end":{"line":18,"column":1}},"key":"xboAAm2GDP"}],"key":"JpG4aFNiFt"}],"key":"WgCI6AfFZe"}],"key":"hW4tuI949v"},{"type":"paragraph","position":{"start":{"line":20,"column":1},"end":{"line":20,"column":1}},"children":[{"type":"text","value":"So, I decided to try an expriment this time: I’d pre-record my tutorial via Zoom, and then attend the session as a helper. The rest of this post is about my experience!","position":{"start":{"line":20,"column":1},"end":{"line":20,"column":1}},"key":"KLYsqFRCZf"}],"key":"JoHMo6jdM5"},{"type":"admonition","children":[{"type":"admonitionTitle","children":[{"type":"text","value":"If you’d like to check out the tutorial","position":{"start":{"line":22,"column":1},"end":{"line":22,"column":1}},"key":"h6iRTNfYGf"}],"key":"fjUA166tR4"},{"type":"paragraph","position":{"start":{"line":24,"column":1},"end":{"line":24,"column":1}},"children":[{"type":"text","value":"Here’s a video of the tutorial in case you’re interested!","position":{"start":{"line":24,"column":1},"end":{"line":24,"column":1}},"key":"WuLnlu7ozG"}],"key":"HooxzES7ib"},{"type":"iframe","src":"https://www.youtube.com/embed/lZ2FHTkyaMU","width":"100%","title":"YouTube video player","key":"GltGsXKhgp"}],"key":"PI0yLvB8tf"},{"type":"heading","depth":2,"position":{"start":{"line":30,"column":1},"end":{"line":30,"column":1}},"children":[{"type":"text","value":"An experiment: record myself ahead of time","position":{"start":{"line":30,"column":1},"end":{"line":30,"column":1}},"key":"QrWukAarxx"}],"identifier":"an-experiment-record-myself-ahead-of-time","label":"An experiment: record myself ahead of time","html_id":"an-experiment-record-myself-ahead-of-time","implicit":true,"key":"Zeqpq47cnw"},{"type":"paragraph","position":{"start":{"line":32,"column":1},"end":{"line":32,"column":1}},"children":[{"type":"text","value":"Here’s what I did:","position":{"start":{"line":32,"column":1},"end":{"line":32,"column":1}},"key":"KFg4mcxG1r"}],"key":"kGGZJfJK8f"},{"type":"heading","depth":3,"position":{"start":{"line":34,"column":1},"end":{"line":34,"column":1}},"children":[{"type":"text","value":"Before the session","position":{"start":{"line":34,"column":1},"end":{"line":34,"column":1}},"key":"AH4BdNblV0"}],"identifier":"before-the-session","label":"Before the session","html_id":"before-the-session","implicit":true,"key":"YQ645fcOcb"},{"type":"list","ordered":true,"start":1,"spread":false,"position":{"start":{"line":36,"column":1},"end":{"line":54,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":36,"column":1},"end":{"line":43,"column":1}},"children":[{"type":"paragraph","position":{"start":{"line":36,"column":1},"end":{"line":36,"column":1}},"children":[{"type":"text","value":"Opened two windows on my screen on top of each other: one window was a Google Slides window with my presentation, the other was a JupyterLab window that I used to demonstrate all of the steps.","position":{"start":{"line":36,"column":1},"end":{"line":36,"column":1}},"key":"od0KhS5b9S"}],"key":"LMyuZEzkpb"},{"type":"paragraph","position":{"start":{"line":38,"column":1},"end":{"line":38,"column":1}},"children":[{"type":"text","value":"Here’s how it looked:","position":{"start":{"line":38,"column":1},"end":{"line":38,"column":1}},"key":"fMChmco21Y"}],"key":"QaSlhQA8Oo"},{"type":"container","kind":"figure","children":[{"type":"image","url":"/build/9c5f30a4a04a0ddea887b8cfbfca92ce.png","alt":"My two-window setup in recording the tutorial.","data":{"altTextIsAutoGenerated":true},"key":"bYSm63EvE4","urlSource":"https://user-images.githubusercontent.com/1839645/146656769-95e0e430-15ac-4b5e-a0ee-7e77e8f7b9ed.png"},{"type":"caption","children":[{"type":"paragraph","position":{"start":{"line":42,"column":1},"end":{"line":42,"column":1}},"children":[{"type":"text","value":"My two-window setup in recording the tutorial.","position":{"start":{"line":42,"column":1},"end":{"line":42,"column":1}},"key":"HNFMO2LHbt"}],"key":"bmhKw6xqhq"}],"key":"k03iqbmbtY"}],"enumerator":"1","key":"APtGM5tnak"}],"key":"zwWY4uQIel"},{"type":"listItem","spread":true,"position":{"start":{"line":44,"column":1},"end":{"line":49,"column":1}},"children":[{"type":"paragraph","position":{"start":{"line":44,"column":1},"end":{"line":44,"column":1}},"children":[{"type":"text","value":"In my slides, I included several prompts with explicit text for people to type into their own terminals and text files. I followed the instructions in these slides and typed them into the JupyterLab window myself.","position":{"start":{"line":44,"column":1},"end":{"line":44,"column":1}},"key":"fG8mos37V7"}],"key":"NV5fltXBTj"},{"type":"container","kind":"figure","children":[{"type":"image","url":"/build/57cb78565e2ef0b7f38641de77baf7c7.png","alt":"Instructions on the top, real-time results on the bottom.","data":{"altTextIsAutoGenerated":true},"key":"SgrH1PBzuz","urlSource":"https://user-images.githubusercontent.com/1839645/146656866-0236e791-9a16-4c60-aa0b-e1ea99e46dd5.png"},{"type":"caption","children":[{"type":"paragraph","position":{"start":{"line":47,"column":1},"end":{"line":47,"column":1}},"children":[{"type":"text","value":"Instructions on the top, real-time results on the bottom.","position":{"start":{"line":47,"column":1},"end":{"line":47,"column":1}},"key":"fuHHpu9qtx"}],"key":"vxvhLt0eyu"}],"key":"UkSO8OnrTu"}],"enumerator":"2","key":"ZSmINiLztS"}],"key":"wIZR4UZTAN"},{"type":"listItem","spread":true,"position":{"start":{"line":50,"column":1},"end":{"line":50,"column":1}},"children":[{"type":"paragraph","position":{"start":{"line":50,"column":1},"end":{"line":50,"column":1}},"children":[{"type":"text","value":"I used Zoom to record myself as I clicked through the slides on the top, and followed along on the bottom as if I were a participant myself.","position":{"start":{"line":50,"column":1},"end":{"line":50,"column":1}},"key":"momb4b7C0R"}],"key":"JiCfaGkcVZ"}],"key":"zMubFemsE4"},{"type":"listItem","spread":true,"position":{"start":{"line":51,"column":1},"end":{"line":52,"column":1}},"children":[{"type":"paragraph","position":{"start":{"line":51,"column":1},"end":{"line":52,"column":1}},"children":[{"type":"text","value":"I split the recording into roughly ","position":{"start":{"line":51,"column":1},"end":{"line":51,"column":1}},"key":"TPevJGibA6"},{"type":"strong","position":{"start":{"line":51,"column":1},"end":{"line":51,"column":1}},"children":[{"type":"text","value":"5 minute sections","position":{"start":{"line":51,"column":1},"end":{"line":51,"column":1}},"key":"r4A8jOXLo7"}],"key":"SicLm3e3NK"},{"type":"text","value":".\nI’d stop the recording briefly for each section, take a quick breather, and then move on to recording the next. This ensured that I had a moment to collect myself and if I messed up a section, I’d only have to re-record 5 minutes instead of 30.","position":{"start":{"line":51,"column":1},"end":{"line":51,"column":1}},"key":"MDysz0P6OB"}],"key":"MRRIn4WzJW"}],"key":"HopSRsVHty"},{"type":"listItem","spread":true,"position":{"start":{"line":53,"column":1},"end":{"line":54,"column":1}},"children":[{"type":"paragraph","position":{"start":{"line":53,"column":1},"end":{"line":53,"column":1}},"children":[{"type":"text","value":"After the recording, I stitched together each of the sections and did a simple fade-out / fade-in using the built-in ","position":{"start":{"line":53,"column":1},"end":{"line":53,"column":1}},"key":"Xjdkci6JJA"},{"type":"link","url":"https://support.microsoft.com/en-us/windows/create-films-with-video-editor-94e651f8-a5be-ae03-3c50-e49f013d47f6","position":{"start":{"line":53,"column":1},"end":{"line":53,"column":1}},"children":[{"type":"text","value":"Windows Video Editor","position":{"start":{"line":53,"column":1},"end":{"line":53,"column":1}},"key":"e9F5uxruY7"}],"urlSource":"https://support.microsoft.com/en-us/windows/create-films-with-video-editor-94e651f8-a5be-ae03-3c50-e49f013d47f6","key":"qmVmDc1YpZ"},{"type":"text","value":".","position":{"start":{"line":53,"column":1},"end":{"line":53,"column":1}},"key":"DANvwkIGCC"}],"key":"j7dWtuZiLy"}],"key":"DSU4goJfnR"}],"key":"VUH6iYiYRH"},{"type":"heading","depth":3,"position":{"start":{"line":55,"column":1},"end":{"line":55,"column":1}},"children":[{"type":"text","value":"During the session","position":{"start":{"line":55,"column":1},"end":{"line":55,"column":1}},"key":"oj9t4l5vac"}],"identifier":"during-the-session","label":"During the session","html_id":"during-the-session","implicit":true,"key":"tjrdsmuTBn"},{"type":"paragraph","position":{"start":{"line":57,"column":1},"end":{"line":60,"column":1}},"children":[{"type":"text","value":"During the tutorial, I played the pre-recorded video as the “presenter”, but spent my time answering questions and addressing issues via the chat box.\nAttendees would watch the pre-recorded video, and speak with me in the chat if anything came up.\nThis meant that I could address questions in real-time but without breaking up the flow of the tutorial.\nIf there was a really important question that was worth discussing as a group, I could have stopped the video to bring it up with everyone.","position":{"start":{"line":57,"column":1},"end":{"line":57,"column":1}},"key":"hYEn2MZGdz"}],"key":"rjrpH9kusC"},{"type":"heading","depth":2,"position":{"start":{"line":62,"column":1},"end":{"line":62,"column":1}},"children":[{"type":"text","value":"Thoughts","position":{"start":{"line":62,"column":1},"end":{"line":62,"column":1}},"key":"Ym65qfdKCG"}],"identifier":"thoughts","label":"Thoughts","html_id":"thoughts","implicit":true,"key":"GYi8Ouy9O3"},{"type":"paragraph","position":{"start":{"line":64,"column":1},"end":{"line":66,"column":1}},"children":[{"type":"text","value":"In all, this worked really nicely!\nThe biggest downside is that it took a bit of extra time to pre-record the video before the talk itself.\nHowever, I believe I might have actually ","position":{"start":{"line":64,"column":1},"end":{"line":64,"column":1}},"key":"GdzBF0VOvH"},{"type":"emphasis","position":{"start":{"line":64,"column":1},"end":{"line":64,"column":1}},"children":[{"type":"text","value":"saved","position":{"start":{"line":64,"column":1},"end":{"line":64,"column":1}},"key":"L4pjyEe6u3"}],"key":"lDhfmyQQvW"},{"type":"text","value":" time, because pre-recording the talk meant that I didn’t feel the need to tinker with my slides in the hours leading up to the talk.","position":{"start":{"line":64,"column":1},"end":{"line":64,"column":1}},"key":"bl3kCrC37G"}],"key":"n6K3YQ3niu"},{"type":"paragraph","position":{"start":{"line":68,"column":1},"end":{"line":68,"column":1}},"children":[{"type":"text","value":"Here are some of the benefits that I noticed:","position":{"start":{"line":68,"column":1},"end":{"line":68,"column":1}},"key":"O6Ap0mLGNy"}],"key":"qgbpoIrZkR"},{"type":"list","ordered":false,"spread":false,"position":{"start":{"line":70,"column":1},"end":{"line":74,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":70,"column":1},"end":{"line":70,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"I could serve as presenter and assistant in one talk - two roles with one person!","position":{"start":{"line":70,"column":1},"end":{"line":70,"column":1}},"key":"uNxRDQmRvN"}],"key":"R9wv7kr5l2"}],"key":"aOx1UqaaGV"},{"type":"listItem","spread":true,"position":{"start":{"line":71,"column":1},"end":{"line":71,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"It gave me more control over the talk length and pacing, because I ","position":{"start":{"line":71,"column":1},"end":{"line":71,"column":1}},"key":"moIkZfp0Ik"},{"type":"emphasis","position":{"start":{"line":71,"column":1},"end":{"line":71,"column":1}},"children":[{"type":"text","value":"knew","position":{"start":{"line":71,"column":1},"end":{"line":71,"column":1}},"key":"m5ISiQi9r9"}],"key":"cRJv76yIvY"},{"type":"text","value":" how much total time was there.","position":{"start":{"line":71,"column":1},"end":{"line":71,"column":1}},"key":"hUsz9ZUQCH"}],"key":"Z9b5qxiexZ"}],"key":"XW1jLN9B8c"},{"type":"listItem","spread":true,"position":{"start":{"line":72,"column":1},"end":{"line":72,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"By recording it ahead of time, I was “done” with the talk much earlier than I normally am (usually I’m stressing about slides until a few moments before the talk)","position":{"start":{"line":72,"column":1},"end":{"line":72,"column":1}},"key":"ExWbTU1v3V"}],"key":"Lfc8TzvNZP"}],"key":"hrcphQ0dm9"},{"type":"listItem","spread":true,"position":{"start":{"line":73,"column":1},"end":{"line":74,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"It also meant I had less anxiety before the event itself.","position":{"start":{"line":73,"column":1},"end":{"line":73,"column":1}},"key":"BE6Z6kL2uq"}],"key":"NYYtE9FIC7"}],"key":"sHHDO2S9AN"}],"key":"AIXQl6c9XM"},{"type":"paragraph","position":{"start":{"line":75,"column":1},"end":{"line":76,"column":1}},"children":[{"type":"text","value":"I’ll give this another shot the next time I’m giving a remote tutorial (or maybe an in-person tutorial by myself).\nIn the meantime, I wanted to write up these thoughts while they were fresh in case this might work for somebody else.","position":{"start":{"line":75,"column":1},"end":{"line":75,"column":1}},"key":"v7ifwG5NKl"}],"key":"HP1Nzj4WUZ"}],"key":"z036CrTvMb"}],"key":"TT2n23Sk23"},"references":{"cite":{"order":[],"data":{}}},"footer":{"navigation":{"prev":{"title":"How to update Sphinx options during the build","url":"/blog/2022/sphinx-update-config","group":"2022"},"next":{"title":"What do people think about rST?","url":"/blog/2020/2020-01-22-rst-thoughts","group":"2020"}}},"domain":"http://localhost:3000"}