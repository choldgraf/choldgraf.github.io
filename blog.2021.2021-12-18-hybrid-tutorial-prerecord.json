tween lecture-style talking and going through steps yourself to make sure that you’re not out-pacing the attendees.","position":{"start":{"line":17,"column":1},"end":{"line":17,"column":1}},"key":"gE6u7po7mJ"}],"key":"Qdj2OtdNu2"}],"key":"n4U7gUUXNK"},{"type":"listItem","spread":true,"position":{"start":{"line":18,"column":1},"end":{"line":19,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"My time working with ","position":{"start":{"line":18,"column":1},"end":{"line":18,"column":1}},"key":"xvnlmQLd7Q"},{"type":"link","url":"https://carpentries.org/","position":{"start":{"line":18,"column":1},"end":{"line":18,"column":1}},"children":[{"type":"text","value":"the Carpentries","position":{"start":{"line":18,"column":1},"end":{"line":18,"column":1}},"key":"S67r3bYPZV"}],"urlSource":"https://carpentries.org/","key":"CfFeFv1GoH"},{"type":"text","value":" taught me that having helpers in a tutorial is extremely useful to keep things on track.","position":{"start":{"line":18,"column":1},"end":{"line":18,"column":1}},"key":"eVrd1it6ms"}],"key":"ddl0m6L3Fh"}],"key":"P4tcNEWDd5"}],"key":"Yr3rdnYS3H"},{"type":"paragraph","position":{"start":{"line":20,"column":1},"end":{"line":20,"column":1}},"children":[{"type":"text","value":"So, I decided to try an expriment this time: I’d pre-record my tutorial via Zoom, and then attend the session as a helper. The rest of this post is about my experience!","position":{"start":{"line":20,"column":1},"end":{"line":20,"column":1}},"key":"E3vIuN6lr0"}],"key":"gtMkIcGAtE"},{"type":"admonition","children":[{"type":"admonitionTitle","children":[{"type":"text","value":"If you’d like to check out the tutorial","position":{"start":{"line":22,"column":1},"end":{"line":22,"column":1}},"key":"d2FolQclh7"}],"key":"iffQYSid2g"},{"type":"paragraph","position":{"start":{"line":24,"column":1},"end":{"line":24,"column":1}},"children":[{"type":"text","value":"Here’s a video of the tutorial in case you’re interested!","position":{"start":{"line":24,"column":1},"end":{"line":24,"column":1}},"key":"t6NLcu5J4N"}],"key":"ZStnOtbrn9"},{"type":"iframe","src":"https://www.youtube.com/embed/lZ2FHTkyaMU","width":"100%","title":"YouTube video player","key":"V9viPAo5Ye"}],"key":"URpm6JRppR"},{"type":"heading","depth":2,"position":{"start":{"line":30,"column":1},"end":{"line":30,"column":1}},"children":[{"type":"text","value":"An experiment: record myself ahead of time","position":{"start":{"line":30,"column":1},"end":{"line":30,"column":1}},"key":"zja8Sd1kej"}],"identifier":"an-experiment-record-myself-ahead-of-time","label":"An experiment: record myself ahead of time","html_id":"an-experiment-record-myself-ahead-of-time","implicit":true,"key":"wRRxWUFgc3"},{"type":"paragraph","position":{"start":{"line":32,"column":1},"end":{"line":32,"column":1}},"children":[{"type":"text","value":"Here’s what I did:","position":{"start":{"line":32,"column":1},"end":{"line":32,"column":1}},"key":"b32AIgYPVu"}],"key":"po5Ll2byn4"},{"type":"heading","depth":3,"position":{"start":{"line":34,"column":1},"end":{"line":34,"column":1}},"children":[{"type":"text","value":"Before the session","position":{"start":{"line":34,"column":1},"end":{"line":34,"column":1}},"key":"oqYA3Evi6n"}],"identifier":"before-the-session","label":"Before the session","html_id":"before-the-session","implicit":true,"key":"t81QL4NfAA"},{"type":"list","ordered":true,"start":1,"spread":false,"position":{"start":{"line":36,"column":1},"end":{"line":54,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":36,"column":1},"end":{"line":43,"column":1}},"children":[{"type":"paragraph","position":{"start":{"line":36,"column":1},"end":{"line":36,"column":1}},"children":[{"type":"text","value":"Opened two windows on my screen on top of each other: one window was a Google Slides window with my presentation, the other was a JupyterLab window that I used to demonstrate all of the steps.","position":{"start":{"line":36,"column":1},"end":{"line":36,"column":1}},"key":"qUmCoGTEmx"}],"key":"tLBB7y8lAl"},{"type":"paragraph","position":{"start":{"line":38,"column":1},"end":{"line":38,"column":1}},"children":[{"type":"text","value":"Here’s how it looked:","position":{"start":{"line":38,"column":1},"end":{"line":38,"column":1}},"key":"PptHLP8BCn"}],"key":"nRLzSBtUg9"},{"type":"container","kind":"figure","children":[{"type":"image","url":"/build/9c5f30a4a04a0ddea887b8cfbfca92ce.png","alt":"My two-window setup in recording the tutorial.","data":{"altTextIsAutoGenerated":true},"key":"NUpGkBm16K","urlSource":"https://user-images.githubusercontent.com/1839645/146656769-95e0e430-15ac-4b5e-a0ee-7e77e8f7b9ed.png"},{"type":"caption","children":[{"type":"paragraph","position":{"start":{"line":42,"column":1},"end":{"line":42,"column":1}},"children":[{"type":"text","value":"My two-window setup in recording the tutorial.","position":{"start":{"line":42,"column":1},"end":{"line":42,"column":1}},"key":"XxMd09DNRz"}],"key":"iFEuHsnmE1"}],"key":"T3t4kf0Xnc"}],"enumerator":"1","key":"a7KHINNBSK"}],"key":"f5lEXhtXsK"},{"type":"listItem","spread":true,"position":{"start":{"line":44,"column":1},"end":{"line":49,"column":1}},"children":[{"type":"paragraph","position":{"start":{"line":44,"column":1},"end":{"line":44,"column":1}},"children":[{"type":"text","value":"In my slides, I included several prompts with explicit text for people to type into their own terminals and text files. I followed the instructions in these slides and typed them into the JupyterLab window myself.","position":{"start":{"line":44,"column":1},"end":{"line":44,"column":1}},"key":"y6Xl3h0QAs"}],"key":"ndBM1RQDqn"},{"type":"container","kind":"figure","children":[{"type":"image","url":"/build/57cb78565e2ef0b7f38641de77baf7c7.png","alt":"Instructions on the top, real-time results on the bottom.","data":{"altTextIsAutoGenerated":true},"key":"WCGL4wD58B","urlSource":"https://user-images.githubusercontent.com/1839645/146656866-0236e791-9a16-4c60-aa0b-e1ea99e46dd5.png"},{"type":"caption","children":[{"type":"paragraph","position":{"start":{"line":47,"column":1},"end":{"line":47,"column":1}},"children":[{"type":"text","value":"Instructions on the top, real-time results on the bottom.","position":{"start":{"line":47,"column":1},"end":{"line":47,"column":1}},"key":"c8DNFmJyNZ"}],"key":"O9DHn79KZc"}],"key":"EJSYLLbepw"}],"enumerator":"2","key":"YVvv6RMR9T"}],"key":"Uy1H5JTrXV"},{"type":"listItem","spread":true,"position":{"start":{"line":50,"column":1},"end":{"line":50,"column":1}},"children":[{"type":"paragraph","position":{"start":{"line":50,"column":1},"end":{"line":50,"column":1}},"children":[{"type":"text","value":"I used Zoom to record myself as I clicked through the slides on the top, and followed along on the bottom as if I were a participant myself.","position":{"start":{"line":50,"column":1},"end":{"line":50,"column":1}},"key":"PDKSXTJ0pp"}],"key":"Oh9XXweUaC"}],"key":"qOvedGY2Il"},{"type":"listItem","spread":true,"position":{"start":{"line":51,"column":1},"end":{"line":52,"column":1}},"children":[{"type":"paragraph","position":{"start":{"line":51,"column":1},"end":{"line":52,"column":1}},"children":[{"type":"text","value":"I split the recording into roughly ","position":{"start":{"line":51,"column":1},"end":{"line":51,"column":1}},"key":"LbVZg4oD7f"},{"type":"strong","position":{"start":{"line":51,"column":1},"end":{"line":51,"column":1}},"children":[{"type":"text","value":"5 minute sections","position":{"start":{"line":51,"column":1},"end":{"line":51,"column":1}},"key":"KwsiRqTFPs"}],"key":"GEYmGFQq43"},{"type":"text","value":".\nI’d stop the recording briefly for each section, take a quick breather, and then move on to recording the next. This ensured that I had a moment to collect myself and if I messed up a section, I’d only have to re-record 5 minutes instead of 30.","position":{"start":{"line":51,"column":1},"end":{"line":51,"column":1}},"key":"MDamohkrkE"}],"key":"uNZRnbm2jL"}],"key":"k1vhWxO1as"},{"type":"listItem","spread":true,"position":{"start":{"line":53,"column":1},"end":{"line":54,"column":1}},"children":[{"type":"paragraph","position":{"start":{"line":53,"column":1},"end":{"line":53,"column":1}},"children":[{"type":"text","value":"After the recording, I stitched together each of the sections and did a simple fade-out / fade-in using the built-in ","position":{"start":{"line":53,"column":1},"end":{"line":53,"column":1}},"key":"YWthXBOuwq"},{"type":"link","url":"https://support.microsoft.com/en-us/windows/create-films-with-video-editor-94e651f8-a5be-ae03-3c50-e49f013d47f6","position":{"start":{"line":53,"column":1},"end":{"line":53,"column":1}},"children":[{"type":"text","value":"Windows Video Editor","position":{"start":{"line":53,"column":1},"end":{"line":53,"column":1}},"key":"Lqou55SkD2"}],"urlSource":"https://support.microsoft.com/en-us/windows/create-films-with-video-editor-94e651f8-a5be-ae03-3c50-e49f013d47f6","key":"QEEHFML1gu"},{"type":"text","value":".","position":{"start":{"line":53,"column":1},"end":{"line":53,"column":1}},"key":"fpTXsJ3esM"}],"key":"Casn3X3A5C"}],"key":"U7VyqLhlWc"}],"key":"PPWSwJ8Rc6"},{"type":"heading","depth":3,"position":{"start":{"line":55,"column":1},"end":{"line":55,"column":1}},"children":[{"type":"text","value":"During the session","position":{"start":{"line":55,"column":1},"end":{"line":55,"column":1}},"key":"GHT2JyFrLx"}],"identifier":"during-the-session","label":"During the session","html_id":"during-the-session","implicit":true,"key":"NEaLDVjSHD"},{"type":"paragraph","position":{"start":{"line":57,"column":1},"end":{"line":60,"column":1}},"children":[{"type":"text","value":"During the tutorial, I played the pre-recorded video as the “presenter”, but spent my time answering questions and addressing issues via the chat box.\nAttendees would watch the pre-recorded video, and speak with me in the chat if anything came up.\nThis meant that I could address questions in real-time but without breaking up the flow of the tutorial.\nIf there was a really important question that was worth discussing as a group, I could have stopped the video to bring it up with everyone.","position":{"start":{"line":57,"column":1},"end":{"line":57,"column":1}},"key":"UAY70aaLI8"}],"key":"LV50uJACMw"},{"type":"heading","depth":2,"position":{"start":{"line":62,"column":1},"end":{"line":62,"column":1}},"children":[{"type":"text","value":"Thoughts","position":{"start":{"line":62,"column":1},"end":{"line":62,"column":1}},"key":"CHztr5y42G"}],"identifier":"thoughts","label":"Thoughts","html_id":"thoughts","implicit":true,"key":"sLMGoZcTtQ"},{"type":"paragraph","position":{"start":{"line":64,"column":1},"end":{"line":66,"column":1}},"children":[{"type":"text","value":"In all, this worked really nicely!\nThe biggest downside is that it took a bit of extra time to pre-record the video before the talk itself.\nHowever, I believe I might have actually ","position":{"start":{"line":64,"column":1},"end":{"line":64,"column":1}},"key":"OvKoO9gstQ"},{"type":"emphasis","position":{"start":{"line":64,"column":1},"end":{"line":64,"column":1}},"children":[{"type":"text","value":"saved","position":{"start":{"line":64,"column":1},"end":{"line":64,"column":1}},"key":"as9pJ5nckE"}],"key":"aElZZfGJfd"},{"type":"text","value":" time, because pre-recording the talk meant that I didn’t feel the need to tinker with my slides in the hours leading up to the talk.","position":{"start":{"line":64,"column":1},"end":{"line":64,"column":1}},"key":"n77sTW73JK"}],"key":"oLmHCjiYFz"},{"type":"paragraph","position":{"start":{"line":68,"column":1},"end":{"line":68,"column":1}},"children":[{"type":"text","value":"Here are some of the benefits that I noticed:","position":{"start":{"line":68,"column":1},"end":{"line":68,"column":1}},"key":"kHiwoHcYrv"}],"key":"TQ4nVlKxw0"},{"type":"list","ordered":false,"spread":false,"position":{"start":{"line":70,"column":1},"end":{"line":74,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":70,"column":1},"end":{"line":70,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"I could serve as presenter and assistant in one talk - two roles with one person!","position":{"start":{"line":70,"column":1},"end":{"line":70,"column":1}},"key":"Ei2vjV1N3u"}],"key":"b8eYuJCuqe"}],"key":"oYwbEHcPtp"},{"type":"listItem","spread":true,"position":{"start":{"line":71,"column":1},"end":{"line":71,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"It gave me more control over the talk length and pacing, because I ","position":{"start":{"line":71,"column":1},"end":{"line":71,"column":1}},"key":"QHw5uZwh5k"},{"type":"emphasis","position":{"start":{"line":71,"column":1},"end":{"line":71,"column":1}},"children":[{"type":"text","value":"knew","position":{"start":{"line":71,"column":1},"end":{"line":71,"column":1}},"key":"RN92whfVk0"}],"key":"FCSwB8e5Lt"},{"type":"text","value":" how much total time was there.","position":{"start":{"line":71,"column":1},"end":{"line":71,"column":1}},"key":"wieZvz3l0Z"}],"key":"qXG9o4wGdu"}],"key":"hc7RSi3R0x"},{"type":"listItem","spread":true,"position":{"start":{"line":72,"column":1},"end":{"line":72,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"By recording it ahead of time, I was “done” with the talk much earlier than I normally am (usually I’m stressing about slides until a few moments before the talk)","position":{"start":{"line":72,"column":1},"end":{"line":72,"column":1}},"key":"LBXEEUaNgQ"}],"key":"bZ0aKqsBmA"}],"key":"bKkKaYtgIv"},{"type":"listItem","spread":true,"position":{"start":{"line":73,"column":1},"end":{"line":74,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"It also meant I had less anxiety before the event itself.","position":{"start":{"line":73,"column":1},"end":{"line":73,"column":1}},"key":"n1BNcQqWxi"}],"key":"AiOwD2lgBJ"}],"key":"SwDsiwy6m1"}],"key":"aZ6ogzit9q"},{"type":"paragraph","position":{"start":{"line":75,"column":1},"end":{"line":76,"column":1}},"children":[{"type":"text","value":"I’ll give this another shot the next time I’m giving a remote tutorial (or maybe an in-person tutorial by myself).\nIn the meantime, I wanted to write up these thoughts while they were fresh in case this might work for somebody else.","position":{"start":{"line":75,"column":1},"end":{"line":75,"column":1}},"key":"k2bDxCID5b"}],"key":"m3u0RwgcO0"}],"key":"NHRMfvL2sQ"}],"key":"kEIdo9q7wd"},"references":{"cite":{"order":[],"data":{}}},"footer":{"navigation":{"prev":{"title":"How to update Sphinx options during the build","url":"/blog/2022/sphinx-update-config","group":"2022"},"next":{"title":"What do people think about rST?","url":"/blog/2020/2020-01-22-rst-thoughts","group":"2020"}}},"domain":"http://localhost:3000"}