":{"start":{"line":24,"column":1},"end":{"line":24,"column":1}},"key":"LQ9WbDk61o"}],"key":"yMqliAIV1V"},{"type":"iframe","src":"https://www.youtube.com/embed/lZ2FHTkyaMU","width":"100%","key":"gPU5VGqwPG"}],"key":"MYbP94lcWE"},{"type":"heading","depth":2,"position":{"start":{"line":30,"column":1},"end":{"line":30,"column":1}},"children":[{"type":"text","value":"An experiment: record myself ahead of time","position":{"start":{"line":30,"column":1},"end":{"line":30,"column":1}},"key":"Ffr3DnJTRR"}],"identifier":"an-experiment-record-myself-ahead-of-time","label":"An experiment: record myself ahead of time","html_id":"an-experiment-record-myself-ahead-of-time","implicit":true,"key":"abcIrrqSbX"},{"type":"paragraph","position":{"start":{"line":32,"column":1},"end":{"line":32,"column":1}},"children":[{"type":"text","value":"Here’s what I did:","position":{"start":{"line":32,"column":1},"end":{"line":32,"column":1}},"key":"EAsKn26ZuM"}],"key":"kiCut4sTVW"},{"type":"heading","depth":3,"position":{"start":{"line":34,"column":1},"end":{"line":34,"column":1}},"children":[{"type":"text","value":"Before the session","position":{"start":{"line":34,"column":1},"end":{"line":34,"column":1}},"key":"mu1O9Cfx3E"}],"identifier":"before-the-session","label":"Before the session","html_id":"before-the-session","implicit":true,"key":"Q3IQG6WRqn"},{"type":"list","ordered":true,"start":1,"spread":false,"position":{"start":{"line":36,"column":1},"end":{"line":54,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":36,"column":1},"end":{"line":43,"column":1}},"children":[{"type":"paragraph","position":{"start":{"line":36,"column":1},"end":{"line":36,"column":1}},"children":[{"type":"text","value":"Opened two windows on my screen on top of each other: one window was a Google Slides window with my presentation, the other was a JupyterLab window that I used to demonstrate all of the steps.","position":{"start":{"line":36,"column":1},"end":{"line":36,"column":1}},"key":"wUqWuTYURd"}],"key":"MoNuUhL0Ls"},{"type":"paragraph","position":{"start":{"line":38,"column":1},"end":{"line":38,"column":1}},"children":[{"type":"text","value":"Here’s how it looked:","position":{"start":{"line":38,"column":1},"end":{"line":38,"column":1}},"key":"fjqlwzkSTt"}],"key":"IFqd9UNNkp"},{"type":"container","kind":"figure","children":[{"type":"image","url":"/build/9c5f30a4a04a0ddea887b8cfbfca92ce.png","alt":"My two-window setup in recording the tutorial.","data":{"altTextIsAutoGenerated":true},"key":"PZcabDMnCd","urlSource":"https://user-images.githubusercontent.com/1839645/146656769-95e0e430-15ac-4b5e-a0ee-7e77e8f7b9ed.png"},{"type":"caption","children":[{"type":"paragraph","position":{"start":{"line":42,"column":1},"end":{"line":42,"column":1}},"children":[{"type":"text","value":"My two-window setup in recording the tutorial.","position":{"start":{"line":42,"column":1},"end":{"line":42,"column":1}},"key":"npJDFVGQvR"}],"key":"aInoHg3BUR"}],"key":"JqFKuRcPEh"}],"enumerator":"1","key":"RSzFPKLwwo"}],"key":"t7FD1wlF8Y"},{"type":"listItem","spread":true,"position":{"start":{"line":44,"column":1},"end":{"line":49,"column":1}},"children":[{"type":"paragraph","position":{"start":{"line":44,"column":1},"end":{"line":44,"column":1}},"children":[{"type":"text","value":"In my slides, I included several prompts with explicit text for people to type into their own terminals and text files. I followed the instructions in these slides and typed them into the JupyterLab window myself.","position":{"start":{"line":44,"column":1},"end":{"line":44,"column":1}},"key":"lxmQF7T1vq"}],"key":"MVaoHWJ1KH"},{"type":"container","kind":"figure","children":[{"type":"image","url":"/build/57cb78565e2ef0b7f38641de77baf7c7.png","alt":"Instructions on the top, real-time results on the bottom.","data":{"altTextIsAutoGenerated":true},"key":"mRb4oonXUM","urlSource":"https://user-images.githubusercontent.com/1839645/146656866-0236e791-9a16-4c60-aa0b-e1ea99e46dd5.png"},{"type":"caption","children":[{"type":"paragraph","position":{"start":{"line":47,"column":1},"end":{"line":47,"column":1}},"children":[{"type":"text","value":"Instructions on the top, real-time results on the bottom.","position":{"start":{"line":47,"column":1},"end":{"line":47,"column":1}},"key":"iXYptFx41V"}],"key":"vKw0G2lNjt"}],"key":"ejbVTD9nod"}],"enumerator":"2","key":"b9EsRnb4Fm"}],"key":"MPp3eAnwwi"},{"type":"listItem","spread":true,"position":{"start":{"line":50,"column":1},"end":{"line":50,"column":1}},"children":[{"type":"paragraph","position":{"start":{"line":50,"column":1},"end":{"line":50,"column":1}},"children":[{"type":"text","value":"I used Zoom to record myself as I clicked through the slides on the top, and followed along on the bottom as if I were a participant myself.","position":{"start":{"line":50,"column":1},"end":{"line":50,"column":1}},"key":"HgN1Yzk9B9"}],"key":"sCT4mc4UJ8"}],"key":"PuNyMFfhvK"},{"type":"listItem","spread":true,"position":{"start":{"line":51,"column":1},"end":{"line":52,"column":1}},"children":[{"type":"paragraph","position":{"start":{"line":51,"column":1},"end":{"line":52,"column":1}},"children":[{"type":"text","value":"I split the recording into roughly ","position":{"start":{"line":51,"column":1},"end":{"line":51,"column":1}},"key":"TWEi06EWdJ"},{"type":"strong","position":{"start":{"line":51,"column":1},"end":{"line":51,"column":1}},"children":[{"type":"text","value":"5 minute sections","position":{"start":{"line":51,"column":1},"end":{"line":51,"column":1}},"key":"HTIOgLkkLt"}],"key":"kuGj179Tp4"},{"type":"text","value":".\nI’d stop the recording briefly for each section, take a quick breather, and then move on to recording the next. This ensured that I had a moment to collect myself and if I messed up a section, I’d only have to re-record 5 minutes instead of 30.","position":{"start":{"line":51,"column":1},"end":{"line":51,"column":1}},"key":"RYd5VAltLm"}],"key":"tYWjkwEMev"}],"key":"LZo3UxjOec"},{"type":"listItem","spread":true,"position":{"start":{"line":53,"column":1},"end":{"line":54,"column":1}},"children":[{"type":"paragraph","position":{"start":{"line":53,"column":1},"end":{"line":53,"column":1}},"children":[{"type":"text","value":"After the recording, I stitched together each of the sections and did a simple fade-out / fade-in using the built-in ","position":{"start":{"line":53,"column":1},"end":{"line":53,"column":1}},"key":"WvP6bfjuyb"},{"type":"link","url":"https://support.microsoft.com/en-us/windows/create-films-with-video-editor-94e651f8-a5be-ae03-3c50-e49f013d47f6","position":{"start":{"line":53,"column":1},"end":{"line":53,"column":1}},"children":[{"type":"text","value":"Windows Video Editor","position":{"start":{"line":53,"column":1},"end":{"line":53,"column":1}},"key":"LJNRru7yt9"}],"urlSource":"https://support.microsoft.com/en-us/windows/create-films-with-video-editor-94e651f8-a5be-ae03-3c50-e49f013d47f6","key":"cgDhlhXYJr"},{"type":"text","value":".","position":{"start":{"line":53,"column":1},"end":{"line":53,"column":1}},"key":"L62vLQVTP2"}],"key":"vAnYN1BoMQ"}],"key":"jO17IAEk8K"}],"key":"XwUepRKNY4"},{"type":"heading","depth":3,"position":{"start":{"line":55,"column":1},"end":{"line":55,"column":1}},"children":[{"type":"text","value":"During the session","position":{"start":{"line":55,"column":1},"end":{"line":55,"column":1}},"key":"tYdZ7db0bj"}],"identifier":"during-the-session","label":"During the session","html_id":"during-the-session","implicit":true,"key":"TYXqp99rOl"},{"type":"paragraph","position":{"start":{"line":57,"column":1},"end":{"line":60,"column":1}},"children":[{"type":"text","value":"During the tutorial, I played the pre-recorded video as the “presenter”, but spent my time answering questions and addressing issues via the chat box.\nAttendees would watch the pre-recorded video, and speak with me in the chat if anything came up.\nThis meant that I could address questions in real-time but without breaking up the flow of the tutorial.\nIf there was a really important question that was worth discussing as a group, I could have stopped the video to bring it up with everyone.","position":{"start":{"line":57,"column":1},"end":{"line":57,"column":1}},"key":"rLXvMScYZn"}],"key":"pk87Omhskf"},{"type":"heading","depth":2,"position":{"start":{"line":62,"column":1},"end":{"line":62,"column":1}},"children":[{"type":"text","value":"Thoughts","position":{"start":{"line":62,"column":1},"end":{"line":62,"column":1}},"key":"c0WtBcwVCA"}],"identifier":"thoughts","label":"Thoughts","html_id":"thoughts","implicit":true,"key":"H7TQiAWfWg"},{"type":"paragraph","position":{"start":{"line":64,"column":1},"end":{"line":66,"column":1}},"children":[{"type":"text","value":"In all, this worked really nicely!\nThe biggest downside is that it took a bit of extra time to pre-record the video before the talk itself.\nHowever, I believe I might have actually ","position":{"start":{"line":64,"column":1},"end":{"line":64,"column":1}},"key":"F50YUdTBED"},{"type":"emphasis","position":{"start":{"line":64,"column":1},"end":{"line":64,"column":1}},"children":[{"type":"text","value":"saved","position":{"start":{"line":64,"column":1},"end":{"line":64,"column":1}},"key":"DqH9cnwjmb"}],"key":"svcjztZEQc"},{"type":"text","value":" time, because pre-recording the talk meant that I didn’t feel the need to tinker with my slides in the hours leading up to the talk.","position":{"start":{"line":64,"column":1},"end":{"line":64,"column":1}},"key":"HXeocQzPyV"}],"key":"wXeONu2n8P"},{"type":"paragraph","position":{"start":{"line":68,"column":1},"end":{"line":68,"column":1}},"children":[{"type":"text","value":"Here are some of the benefits that I noticed:","position":{"start":{"line":68,"column":1},"end":{"line":68,"column":1}},"key":"lh1wQuzGZF"}],"key":"V7rYDFCh8h"},{"type":"list","ordered":false,"spread":false,"position":{"start":{"line":70,"column":1},"end":{"line":74,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":70,"column":1},"end":{"line":70,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"I could serve as presenter and assistant in one talk - two roles with one person!","position":{"start":{"line":70,"column":1},"end":{"line":70,"column":1}},"key":"LnYqyuT39v"}],"key":"mzxwIhM21o"}],"key":"uNxAOnreig"},{"type":"listItem","spread":true,"position":{"start":{"line":71,"column":1},"end":{"line":71,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"It gave me more control over the talk length and pacing, because I ","position":{"start":{"line":71,"column":1},"end":{"line":71,"column":1}},"key":"z1wWOzmr2S"},{"type":"emphasis","position":{"start":{"line":71,"column":1},"end":{"line":71,"column":1}},"children":[{"type":"text","value":"knew","position":{"start":{"line":71,"column":1},"end":{"line":71,"column":1}},"key":"GzxiEINTZS"}],"key":"g6SnMPPWGl"},{"type":"text","value":" how much total time was there.","position":{"start":{"line":71,"column":1},"end":{"line":71,"column":1}},"key":"BRK0HeuaOQ"}],"key":"npZeu1NvpF"}],"key":"FhUWKgqlXB"},{"type":"listItem","spread":true,"position":{"start":{"line":72,"column":1},"end":{"line":72,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"By recording it ahead of time, I was “done” with the talk much earlier than I normally am (usually I’m stressing about slides until a few moments before the talk)","position":{"start":{"line":72,"column":1},"end":{"line":72,"column":1}},"key":"jfL149Kzbj"}],"key":"AgNlmTccku"}],"key":"iB2msALmhY"},{"type":"listItem","spread":true,"position":{"start":{"line":73,"column":1},"end":{"line":74,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"It also meant I had less anxiety before the event itself.","position":{"start":{"line":73,"column":1},"end":{"line":73,"column":1}},"key":"nB86YHZCJa"}],"key":"ZwqigFvBTL"}],"key":"u0TpLs6SBl"}],"key":"rYUBVs6rtn"},{"type":"paragraph","position":{"start":{"line":75,"column":1},"end":{"line":76,"column":1}},"children":[{"type":"text","value":"I’ll give this another shot the next time I’m giving a remote tutorial (or maybe an in-person tutorial by myself).\nIn the meantime, I wanted to write up these thoughts while they were fresh in case this might work for somebody else.","position":{"start":{"line":75,"column":1},"end":{"line":75,"column":1}},"key":"VFMWdtCXZR"}],"key":"cOrq3acEGe"}],"key":"prF5i2GrR6"}],"key":"tt1M2FXieE"},"references":{"cite":{"order":[],"data":{}}},"footer":{"navigation":{"prev":{"title":"How to update Sphinx options during the build","url":"/blog/2022/sphinx-update-config","group":"2022"},"next":{"title":"What do people think about rST?","url":"/blog/2020/2020-01-22-rst-thoughts","group":"2020"}}},"domain":"http://localhost:3000"}