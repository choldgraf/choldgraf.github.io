 week.","position":{"start":{"line":74,"column":1},"end":{"line":74,"column":1}},"key":"Oh7USkyEva"}],"key":"WSm2wMb4cz"},{"type":"paragraph","position":{"start":{"line":77,"column":1},"end":{"line":79,"column":1}},"children":[{"type":"text","value":"An additional component is that each card is assigned a number of ","position":{"start":{"line":77,"column":1},"end":{"line":77,"column":1}},"key":"RxiGEZCcHE"},{"type":"strong","position":{"start":{"line":77,"column":1},"end":{"line":77,"column":1}},"children":[{"type":"text","value":"hours needed to complete the card","position":{"start":{"line":77,"column":1},"end":{"line":77,"column":1}},"key":"KRJZiu6aax"}],"key":"Z3TO00oEVU"},{"type":"text","value":".\nI try to keep the total number of hours on this board to <= 20. I’ve found that this is a realistic\nbalance between “enough hours to actually get stuff done” and “not so many hours that I won’t finish them”.","position":{"start":{"line":77,"column":1},"end":{"line":77,"column":1}},"key":"QYlzhCN6nL"}],"key":"RQlD6U0j9j"},{"type":"paragraph","position":{"start":{"line":81,"column":1},"end":{"line":82,"column":1}},"children":[{"type":"text","value":"To assign and keep track of the hours with each card, I use a chrome extension called ","position":{"start":{"line":81,"column":1},"end":{"line":81,"column":1}},"key":"bY7RImrv3l"},{"type":"link","url":"https://chrome.google.com/webstore/detail/plus-for-trello-time-trac/gjjpophepkbhejnglcmkdnncmaanojkf?hl=en","position":{"start":{"line":81,"column":1},"end":{"line":81,"column":1}},"children":[{"type":"strong","position":{"start":{"line":81,"column":1},"end":{"line":81,"column":1}},"children":[{"type":"text","value":"Plus for Trello","position":{"start":{"line":81,"column":1},"end":{"line":81,"column":1}},"key":"Lri3tiVpWA"}],"key":"xQFJ3wCWLU"}],"urlSource":"https://chrome.google.com/webstore/detail/plus-for-trello-time-trac/gjjpophepkbhejnglcmkdnncmaanojkf?hl=en","key":"hQ5g5BfoyX"},{"type":"text","value":". This\nadds fields for “estimated” and “spent” hours that I update over the week.","position":{"start":{"line":81,"column":1},"end":{"line":81,"column":1}},"key":"LLw24TufMN"}],"key":"CaPp4oDnTx"},{"type":"paragraph","position":{"start":{"line":84,"column":1},"end":{"line":84,"column":1}},"children":[{"type":"text","value":"Here’s an example of a weekly board:","position":{"start":{"line":84,"column":1},"end":{"line":84,"column":1}},"key":"ZvYMey11Sd"}],"key":"kDU2jXbXpC"},{"type":"image","url":"/build/trello-board-active-301082837a10f0f2277716bbdd7cc1f7.png","position":{"start":{"line":86,"column":1},"end":{"line":86,"column":1}},"key":"YPDsoDoWJK","urlSource":"../../images/2018/trello-board-active.png"},{"type":"heading","depth":2,"position":{"start":{"line":89,"column":1},"end":{"line":89,"column":1}},"children":[{"type":"text","value":"How does this work in practice?","position":{"start":{"line":89,"column":1},"end":{"line":89,"column":1}},"key":"Ttmeu1Gcnv"}],"identifier":"how-does-this-work-in-practice","label":"How does this work in practice?","html_id":"how-does-this-work-in-practice","implicit":true,"key":"fzMOBTHUqb"},{"type":"paragraph","position":{"start":{"line":91,"column":1},"end":{"line":92,"column":1}},"children":[{"type":"text","value":"I use a tool called ","position":{"start":{"line":91,"column":1},"end":{"line":91,"column":1}},"key":"WHDNa0QxOR"},{"type":"link","url":"https://butlerfortrello.com/","position":{"start":{"line":91,"column":1},"end":{"line":91,"column":1}},"children":[{"type":"strong","position":{"start":{"line":91,"column":1},"end":{"line":91,"column":1}},"children":[{"type":"text","value":"Butler for Trello","position":{"start":{"line":91,"column":1},"end":{"line":91,"column":1}},"key":"Q8pxuEkM6n"}],"key":"pfgfpjmyYU"}],"urlSource":"https://butlerfortrello.com/","key":"TSUhoX7kSN"},{"type":"text","value":" (BFT) to manage how cards flow through this system.\nLets you automate various tasks in Trello by writing messages that it parses as instructions.","position":{"start":{"line":91,"column":1},"end":{"line":91,"column":1}},"key":"eNkjGQD9vC"}],"key":"wO8A7FvY21"},{"type":"paragraph","position":{"start":{"line":94,"column":1},"end":{"line":95,"column":1}},"children":[{"type":"text","value":"Remember that “Doing” list that I mentioned in each project board? Any time I move a card into\na “Doing” list on a project board, the following happens:","position":{"start":{"line":94,"column":1},"end":{"line":94,"column":1}},"key":"tn5pFdTh47"}],"key":"osBxRpZbe4"},{"type":"list","ordered":false,"spread":false,"position":{"start":{"line":97,"column":1},"end":{"line":99,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":97,"column":1},"end":{"line":97,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"BFT adds a custom field to the card that has the Project Board ID that it came from","position":{"start":{"line":97,"column":1},"end":{"line":97,"column":1}},"key":"lN06lvaC5q"}],"key":"ertTj1J0Qk"}],"key":"v2AXNHUpuK"},{"type":"listItem","spread":true,"position":{"start":{"line":98,"column":1},"end":{"line":99,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"BFT moves the card to the “weekly” board, to a list with the same name as the project board","position":{"start":{"line":98,"column":1},"end":{"line":98,"column":1}},"key":"egDr2vxKZX"}],"key":"BrQOmdjH8G"}],"key":"gWkcCrJoQq"}],"key":"xAmwzc9kCu"},{"type":"paragraph","position":{"start":{"line":100,"column":1},"end":{"line":101,"column":1}},"children":[{"type":"text","value":"Moreover, remember that there was a “Done” list in my weekly board? That also does something\nspecial. I have a BFT link that, whenever clicked, does the following:","position":{"start":{"line":100,"column":1},"end":{"line":100,"column":1}},"key":"DdCMFX2ANg"}],"key":"lKzF3a0XSV"},{"type":"list","ordered":false,"spread":false,"position":{"start":{"line":103,"column":1},"end":{"line":107,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":103,"column":1},"end":{"line":103,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Loop through every card in the “Done” list","position":{"start":{"line":103,"column":1},"end":{"line":103,"column":1}},"key":"gVkNUVo2H1"}],"key":"Fqi9H5lqqa"}],"key":"NoVuYqJnMz"},{"type":"listItem","spread":true,"position":{"start":{"line":104,"column":1},"end":{"line":104,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"For each card, find the Board ID that represents the board the card came from","position":{"start":{"line":104,"column":1},"end":{"line":104,"column":1}},"key":"R8cylk0Sc3"}],"key":"wfjG8O3sMs"}],"key":"jUH0C8otCr"},{"type":"listItem","spread":true,"position":{"start":{"line":105,"column":1},"end":{"line":107,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Move the card to that board, put it in a “Done” list that is automatically created using the\nnumber of the current active week.","position":{"start":{"line":105,"column":1},"end":{"line":105,"column":1}},"key":"jRAELrLyph"}],"key":"vlfxIwmG0i"}],"key":"heBRWWB2lc"}],"key":"ga3IKXPkQK"},{"type":"paragraph","position":{"start":{"line":108,"column":1},"end":{"line":108,"column":1}},"children":[{"type":"text","value":"So, the general flow of cards through this system looks like this:","position":{"start":{"line":108,"column":1},"end":{"line":108,"column":1}},"key":"uJFa95CwF5"}],"key":"WkqKUzpEaV"},{"type":"list","ordered":true,"start":1,"spread":false,"position":{"start":{"line":110,"column":1},"end":{"line":120,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":110,"column":1},"end":{"line":110,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Create cards in a project board that represent things to be done.","position":{"start":{"line":110,"column":1},"end":{"line":110,"column":1}},"key":"oVPAyweqZr"}],"key":"GCUEXwbF0e"}],"key":"MMOY15pFiN"},{"type":"listItem","spread":true,"position":{"start":{"line":111,"column":1},"end":{"line":111,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"When it’s time to work on a task, move it to the “Doing” list","position":{"start":{"line":111,"column":1},"end":{"line":111,"column":1}},"key":"wehDzwI319"}],"key":"mXuiLmnAAh"}],"key":"TwhUTDBHrT"},{"type":"listItem","spread":true,"position":{"start":{"line":112,"column":1},"end":{"line":112,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"BFT moves that card to my “Weekly” board, to a list w/ the project name","position":{"start":{"line":112,"column":1},"end":{"line":112,"column":1}},"key":"ZuPd9zlEhO"}],"key":"QegrvlZmYG"}],"key":"I4JntEdUwu"},{"type":"listItem","spread":true,"position":{"start":{"line":113,"column":1},"end":{"line":114,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"This happens at the beginning of the week, along with an estimation of the time needed for\neach card.","position":{"start":{"line":113,"column":1},"end":{"line":113,"column":1}},"key":"qGLGnWoyAt"}],"key":"ifxnegCvTJ"}],"key":"GG8bnqHTl7"},{"type":"listItem","spread":true,"position":{"start":{"line":115,"column":1},"end":{"line":115,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"As the week progresses, I mark off the hours that I’ve spent on each card.","position":{"start":{"line":115,"column":1},"end":{"line":115,"column":1}},"key":"X5o0dliI3H"}],"key":"Y5npenzS8l"}],"key":"BNz2l1mM6E"},{"type":"listItem","spread":true,"position":{"start":{"line":116,"column":1},"end":{"line":116,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"When the card’s hours remaining reaches 0, I move it to the “Done” list","position":{"start":{"line":116,"column":1},"end":{"line":116,"column":1}},"key":"ydkt0w1Qzw"}],"key":"OYqrzoGFsQ"}],"key":"fFUPYtYd52"},{"type":"listItem","spread":true,"position":{"start":{"line":117,"column":1},"end":{"line":118,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"At the end of the week, I click my “board cleanup” link, and it returns each card to its\noriginal project board.","position":{"start":{"line":117,"column":1},"end":{"line":117,"column":1}},"key":"Ec39zK3UEo"}],"key":"v2X4qBSQBT"}],"key":"oz7w0TuNqy"},{"type":"listItem","spread":true,"position":{"start":{"line":119,"column":1},"end":{"line":120,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Next week, I repeat this cycle.","position":{"start":{"line":119,"column":1},"end":{"line":119,"column":1}},"key":"ozLqTVXNPj"}],"key":"J7dskIt4nF"}],"key":"uxLmFe5PbN"}],"key":"fg0zzolqt1"},{"type":"paragraph","position":{"start":{"line":121,"column":1},"end":{"line":123,"column":1}},"children":[{"type":"text","value":"And that’s about it - I’ve found that this process is a nice way to keep both a high-level\nview of what needs to be done for my various projects (on each project board). It also allows\nmy to dig into specific to-do items throughout the week (on my weekly board).","position":{"start":{"line":121,"column":1},"end":{"line":121,"column":1}},"key":"yYXk9MkCjo"}],"key":"p4IKfDvaQ8"},{"type":"paragraph","position":{"start":{"line":125,"column":1},"end":{"line":126,"column":1}},"children":[{"type":"text","value":"I’d love to hear feedback and thoughts about how other people manage their time throughout\nthe week! Hopefully some of you all find this useful.","position":{"start":{"line":125,"column":1},"end":{"line":125,"column":1}},"key":"XBDIndysQG"}],"key":"uSlO3jemTc"},{"type":"heading","depth":2,"position":{"start":{"line":128,"column":1},"end":{"line":128,"column":1}},"children":[{"type":"text","value":"Extras","position":{"start":{"line":128,"column":1},"end":{"line":128,"column":1}},"key":"VjGAEXxi8G"}],"identifier":"extras","label":"Extras","html_id":"extras","implicit":true,"key":"ywS1j71vnq"},{"type":"paragraph","position":{"start":{"line":130,"column":1},"end":{"line":131,"column":1}},"children":[{"type":"text","value":"Butler for Trello commands can be a little bit difficult to compose. Below I’ll post the\ntwo main commands that I use to handle all the card-moving described above.","position":{"start":{"line":130,"column":1},"end":{"line":130,"column":1}},"key":"K9MDIaKC5d"}],"key":"k1svoYUm5q"},{"type":"heading","depth":3,"position":{"start":{"line":133,"column":1},"end":{"line":133,"column":1}},"children":[{"type":"text","value":"The weekly board","position":{"start":{"line":133,"column":1},"end":{"line":133,"column":1}},"key":"HU7BVDpk4A"}],"identifier":"the-weekly-board","label":"The weekly board","html_id":"the-weekly-board","implicit":true,"key":"MUH3ndtlpK"},{"type":"paragraph","position":{"start":{"line":135,"column":1},"end":{"line":136,"column":1}},"children":[{"type":"text","value":"The weekly board has a “butler” list where the command is defined in a card (that’s how\nyou define board-specific BFT commands). Here’s the command:","position":{"start":{"line":135,"column":1},"end":{"line":135,"column":1}},"key":"MSYqRND3wo"}],"key":"Gw1tquTJKc"},{"type":"paragraph","position":{"start":{"line":138,"column":1},"end":{"line":138,"column":1}},"children":[{"type":"text","value":"{% raw %}","position":{"start":{"line":138,"column":1},"end":{"line":138,"column":1}},"key":"gHazdJcqR3"}],"key":"dIjSNU6uNt"},{"type":"code","lang":"","value":"script: for each card in list \"Return\", remove all labels and move the card to list \"Returned | Week {weeknumber}\" on board \"{{%homeboard}}\" and move list \"Returned | Week {weeknumber}\" on board \"{{%homeboard}}\" to position 1 and clear custom field \"homeboard\"","position":{"start":{"line":139,"column":1},"end":{"line":141,"column":1}},"key":"jFsCT0zJeh"},{"type":"paragraph","position":{"start":{"line":142,"column":1},"end":{"line":142,"column":1}},"children":[{"type":"text","value":"{% endraw %}","position":{"start":{"line":142,"column":1},"end":{"line":142,"column":1}},"key":"NdtA65YPs7"}],"key":"tjb8uCdzR6"},{"type":"heading","depth":3,"position":{"start":{"line":144,"column":1},"end":{"line":144,"column":1}},"children":[{"type":"text","value":"A global command for project boards","position":{"start":{"line":144,"column":1},"end":{"line":144,"column":1}},"key":"H9X4eFZBXx"}],"identifier":"a-global-command-for-project-boards","label":"A global command for project boards","html_id":"a-global-command-for-project-boards","implicit":true,"key":"QJS0cwiamM"},{"type":"paragraph","position":{"start":{"line":146,"column":1},"end":{"line":147,"column":1}},"children":[{"type":"text","value":"I also use a global BFT command that moves the cards from each project board to the weekly\nboard when the card is moved to the “Doing” category.","position":{"start":{"line":146,"column":1},"end":{"line":146,"column":1}},"key":"XGukCGGRT4"}],"key":"S6TwO16PV4"},{"type":"code","lang":"","value":"when a card is added to list \"Doing\" by me, set custom field \"homeboard\" to \"{boardlink}\" and move the card to the top of list \"{boardname}\" on board \"Active\" and move list \"{boardname}\" on board \"Active\" to position 2","position":{"start":{"line":149,"column":1},"end":{"line":151,"column":1}},"key":"nE1NpqiX57"}],"key":"Glk9r0uJhM"}],"key":"pMahpgqyWQ"},"references":{"cite":{"order":[],"data":{}}},"footer":{"navigation":{"prev":{"title":"Introducing makeitpop, a tool to perceptually warp your data!\"","url":"/blog/2018/makeitpop","group":"2018"},"next":{"title":"I like Rust’s governance structure","url":"/blog/2018/rust-governance","group":"2018"}}},"domain":"http://localhost:3000"}