{"version":3,"kind":"Article","sha256":"e649ef40336508b50cf38eb24e3e5e91dad83dc1e8f44d4707f1df7a9bbfbc80","slug":"blog.2018.my-workflow","location":"/blog/2018/my-workflow.md","dependencies":[],"frontmatter":{"title":"My weekly workflow","tags":["productivity"],"date":"2018-10-26","content_includes_title":false,"authors":[{"id":"chris","nameParsed":{"literal":"Chris Holdgraf","given":"Chris","family":"Holdgraf"},"name":"Chris Holdgraf","orcid":"0000-0002-2391-0678","affiliations":["affiliations-myst-generated-uid-0","affiliations-myst-generated-uid-1"],"url":"https://chrisholdgraf.com","github":"choldgraf","twitter":"choldgraf"}],"github":"https://github.com/choldgraf/choldgraf.github.io","affiliations":[{"name":"2i2c","url":"https://2i2c.org","id":"affiliations-myst-generated-uid-0"},{"name":"Project Jupyter","url":"https://jupyter.org","id":"affiliations-myst-generated-uid-1"}],"abbreviations":{"LF":"The Linux Foundation","JF":"The Jupyter Foundation","JEC":"Jupyter Executive Council","JFB":"The Jupyter Foundation Board","SSC":"Software Steering Council","OSPO":"Open Source Program Office"},"numbering":{"title":{"offset":2}},"source_url":"https://github.com/choldgraf/choldgraf.github.io/blob/main/blog/2018/my-workflow.md","edit_url":"https://github.com/choldgraf/choldgraf.github.io/edit/main/blog/2018/my-workflow.md","thumbnail":"/build/trello-board-project-a4d329044360b6751492004ec26b9d24.png","exports":[{"format":"md","filename":"my-workflow.md","url":"/build/my-workflow-04c6e72f517d8125e1c947cb40b471ad.md"}]},"mdast":{"type":"root","children":[{"type":"block","children":[{"type":"paragraph","position":{"start":{"line":11,"column":1},"end":{"line":15,"column":1}},"children":[{"type":"text","value":"I’ve had a bunch of conversations with friends who were interested in how to\nkeep track of the various projects they’re working on, and to prioritize their\ntime over the course of a week. I thought it might be helpful to post my own\napproach to planning time throughout the week in case it’s useful for others to\nriff off of.","position":{"start":{"line":11,"column":1},"end":{"line":11,"column":1}},"key":"Xvy6lYM3nz"}],"key":"u4ziVmXzeT"},{"type":"heading","depth":2,"position":{"start":{"line":17,"column":1},"end":{"line":17,"column":1}},"children":[{"type":"text","value":"General principles","position":{"start":{"line":17,"column":1},"end":{"line":17,"column":1}},"key":"PJM8VlTyfk"}],"identifier":"general-principles","label":"General principles","html_id":"general-principles","implicit":true,"key":"KIMyCQrkjg"},{"type":"paragraph","position":{"start":{"line":19,"column":1},"end":{"line":20,"column":1}},"children":[{"type":"text","value":"First off, a few general principles that I use to guide my thinking on planning\nout the week.","position":{"start":{"line":19,"column":1},"end":{"line":19,"column":1}},"key":"aSjShGevxd"}],"key":"pkK5BXLImW"},{"type":"list","ordered":true,"start":1,"spread":false,"position":{"start":{"line":22,"column":1},"end":{"line":35,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":22,"column":1},"end":{"line":24,"column":1}},"children":[{"type":"paragraph","children":[{"type":"strong","position":{"start":{"line":22,"column":1},"end":{"line":22,"column":1}},"children":[{"type":"text","value":"Be intentional.","position":{"start":{"line":22,"column":1},"end":{"line":22,"column":1}},"key":"yLxw3lGYMm"}],"key":"IVFK4fw1DQ"},{"type":"text","value":" This seems obvious, but I find that if I don’t explicitly define\nwhat I want to work on, I have more of those “where the heck did the day go” kinds\nof weeks.","position":{"start":{"line":22,"column":1},"end":{"line":22,"column":1}},"key":"tZ3NgvutZ3"}],"key":"BAofXdobAT"}],"key":"DSBtzHJ1p8"},{"type":"listItem","spread":true,"position":{"start":{"line":25,"column":1},"end":{"line":27,"column":1}},"children":[{"type":"paragraph","children":[{"type":"strong","position":{"start":{"line":25,"column":1},"end":{"line":25,"column":1}},"children":[{"type":"text","value":"Be strategic.","position":{"start":{"line":25,"column":1},"end":{"line":25,"column":1}},"key":"twaCqNhPDk"}],"key":"TII7MrsjtV"},{"type":"text","value":" There are only so many hours in the day, which means that I need to be\ncareful about what I commit to spending time on. I try to figure out what are the most\nimportant things to do, and ensure I make space for this work before other stuff.","position":{"start":{"line":25,"column":1},"end":{"line":25,"column":1}},"key":"QWWGYJpME1"}],"key":"axlOQNFvJ7"}],"key":"YdgJfdwq0P"},{"type":"listItem","spread":true,"position":{"start":{"line":28,"column":1},"end":{"line":30,"column":1}},"children":[{"type":"paragraph","children":[{"type":"strong","position":{"start":{"line":28,"column":1},"end":{"line":28,"column":1}},"children":[{"type":"text","value":"Be (conservatively) realistic.","position":{"start":{"line":28,"column":1},"end":{"line":28,"column":1}},"key":"Ac65v9xXfl"}],"key":"R1n58QouPa"},{"type":"text","value":" I often get too optimistic with my time and energy levels.\nSometimes you’re tired, sometimes you get distracted, sometimes new work pops up you didn’t\naccount for. For this reason, I only budget about ","position":{"start":{"line":28,"column":1},"end":{"line":28,"column":1}},"key":"Cb3eak3iQu"},{"type":"strong","position":{"start":{"line":28,"column":1},"end":{"line":28,"column":1}},"children":[{"type":"text","value":"20 hours of diligent work a week","position":{"start":{"line":28,"column":1},"end":{"line":28,"column":1}},"key":"YrwneVJ420"}],"key":"XwvEprJIvh"},{"type":"text","value":".","position":{"start":{"line":28,"column":1},"end":{"line":28,"column":1}},"key":"ZLVOhBeYEx"}],"key":"ovjCIE55RY"}],"key":"IzhbcHHgap"},{"type":"listItem","spread":true,"position":{"start":{"line":31,"column":1},"end":{"line":32,"column":1}},"children":[{"type":"paragraph","children":[{"type":"strong","position":{"start":{"line":31,"column":1},"end":{"line":31,"column":1}},"children":[{"type":"text","value":"Be flexible.","position":{"start":{"line":31,"column":1},"end":{"line":31,"column":1}},"key":"AttNFgjNsM"}],"key":"pXEQRCVNG0"},{"type":"text","value":" Finally, don’t worry about following the plan obsessively. Use it as a guide,\nnot a set of chains. If it’s worth re-prioritizing, that’s fine!","position":{"start":{"line":31,"column":1},"end":{"line":31,"column":1}},"key":"kaCIo5bEsH"}],"key":"j8l5c1LyLl"}],"key":"Zi8CJfcgsu"},{"type":"listItem","spread":true,"position":{"start":{"line":33,"column":1},"end":{"line":35,"column":1}},"children":[{"type":"paragraph","children":[{"type":"strong","position":{"start":{"line":33,"column":1},"end":{"line":33,"column":1}},"children":[{"type":"text","value":"Be diligent.","position":{"start":{"line":33,"column":1},"end":{"line":33,"column":1}},"key":"DSrbdHme7m"}],"key":"W15ZDWX244"},{"type":"text","value":" That said, whenever the plans ","position":{"start":{"line":33,"column":1},"end":{"line":33,"column":1}},"key":"ZWV7lk0sEE"},{"type":"emphasis","position":{"start":{"line":33,"column":1},"end":{"line":33,"column":1}},"children":[{"type":"text","value":"do","position":{"start":{"line":33,"column":1},"end":{"line":33,"column":1}},"key":"T0IqRi04Kd"}],"key":"VmfXncDemH"},{"type":"text","value":" change, make sure that this is written down\nsomewhere so that I know I’m being intentional about it.","position":{"start":{"line":33,"column":1},"end":{"line":33,"column":1}},"key":"k3UkhVQxFd"}],"key":"FLPejn6gFI"}],"key":"LTRk35D36N"}],"key":"QWreqTvIfh"},{"type":"heading","depth":2,"position":{"start":{"line":36,"column":1},"end":{"line":36,"column":1}},"children":[{"type":"text","value":"What tools do I use?","position":{"start":{"line":36,"column":1},"end":{"line":36,"column":1}},"key":"Hxj1hFWVpw"}],"identifier":"what-tools-do-i-use","label":"What tools do I use?","html_id":"what-tools-do-i-use","implicit":true,"key":"LfpLfnIQyx"},{"type":"paragraph","position":{"start":{"line":38,"column":1},"end":{"line":38,"column":1}},"children":[{"type":"text","value":"OK so what does this process actually look like? Here’s a general approach:","position":{"start":{"line":38,"column":1},"end":{"line":38,"column":1}},"key":"rYgEXCJpAv"}],"key":"boNGpcAf3R"},{"type":"paragraph","position":{"start":{"line":40,"column":1},"end":{"line":42,"column":1}},"children":[{"type":"text","value":"I use ","position":{"start":{"line":40,"column":1},"end":{"line":40,"column":1}},"key":"jLSoeqdHFF"},{"type":"link","url":"https://trello.com/","position":{"start":{"line":40,"column":1},"end":{"line":40,"column":1}},"children":[{"type":"strong","position":{"start":{"line":40,"column":1},"end":{"line":40,"column":1}},"children":[{"type":"text","value":"Trello","position":{"start":{"line":40,"column":1},"end":{"line":40,"column":1}},"key":"qnfUWrh9DV"}],"key":"vhIkZsNkXi"}],"urlSource":"https://trello.com/","key":"zpRA9YJCA4"},{"type":"text","value":" for managing most of the projects that I work on each week. For those who aren’t familiar,\nTrello is a web app that lets you organize “cards” into vertical lists. It’s useful for Kanban-style\nproject management, and is super popular in technical circles.","position":{"start":{"line":40,"column":1},"end":{"line":40,"column":1}},"key":"bqDQvXWn0S"}],"key":"SI7G3S16DQ"},{"type":"paragraph","position":{"start":{"line":44,"column":1},"end":{"line":44,"column":1}},"children":[{"type":"text","value":"I use two kinds of Trello boards, “project” boards, and my “weekly” board.","position":{"start":{"line":44,"column":1},"end":{"line":44,"column":1}},"key":"rgya8iptX2"}],"key":"HGbM7ygDUB"},{"type":"heading","depth":2,"position":{"start":{"line":46,"column":1},"end":{"line":46,"column":1}},"children":[{"type":"text","value":"Project boards","position":{"start":{"line":46,"column":1},"end":{"line":46,"column":1}},"key":"KvsXmOMl4P"}],"identifier":"project-boards","label":"Project boards","html_id":"project-boards","implicit":true,"key":"v7Oy6uhW0Y"},{"type":"paragraph","position":{"start":{"line":48,"column":1},"end":{"line":48,"column":1}},"children":[{"type":"text","value":"Project boards are project-specific. They’re organized in four primary columns.","position":{"start":{"line":48,"column":1},"end":{"line":48,"column":1}},"key":"V2GWkcR8Xq"}],"key":"nxHCWi6bS4"},{"type":"list","ordered":false,"spread":false,"position":{"start":{"line":50,"column":1},"end":{"line":55,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":50,"column":1},"end":{"line":50,"column":1}},"children":[{"type":"paragraph","children":[{"type":"strong","position":{"start":{"line":50,"column":1},"end":{"line":50,"column":1}},"children":[{"type":"text","value":"Info","position":{"start":{"line":50,"column":1},"end":{"line":50,"column":1}},"key":"rSll9Q81nZ"}],"key":"iSymstTrnY"},{"type":"text","value":" has cards with information about that project. For example, links, notes, attachments, etc.","position":{"start":{"line":50,"column":1},"end":{"line":50,"column":1}},"key":"IDn8ovMO2w"}],"key":"DwXPYN307W"}],"key":"s4pRmvTXiE"},{"type":"listItem","spread":true,"position":{"start":{"line":51,"column":1},"end":{"line":52,"column":1}},"children":[{"type":"paragraph","children":[{"type":"strong","position":{"start":{"line":51,"column":1},"end":{"line":51,"column":1}},"children":[{"type":"text","value":"ToDo","position":{"start":{"line":51,"column":1},"end":{"line":51,"column":1}},"key":"G5oW6HyEEo"}],"key":"oBhoNXR8b2"},{"type":"text","value":" has cards representing tasks that I’ll do eventually. These tend to be more abstract and\nwill evolve over time.","position":{"start":{"line":51,"column":1},"end":{"line":51,"column":1}},"key":"LEfgYYgHTf"}],"key":"DlqiDJ5lP5"}],"key":"CLYsmjGAfr"},{"type":"listItem","spread":true,"position":{"start":{"line":53,"column":1},"end":{"line":53,"column":1}},"children":[{"type":"paragraph","children":[{"type":"strong","position":{"start":{"line":53,"column":1},"end":{"line":53,"column":1}},"children":[{"type":"text","value":"Next","position":{"start":{"line":53,"column":1},"end":{"line":53,"column":1}},"key":"f1CwPejEvt"}],"key":"LROyKLgczg"},{"type":"text","value":" has cards representing actionable tasks that I’ll do soon.","position":{"start":{"line":53,"column":1},"end":{"line":53,"column":1}},"key":"flDEN9TzPt"}],"key":"fdHPVFaYNh"}],"key":"a8GkbSHi8F"},{"type":"listItem","spread":true,"position":{"start":{"line":54,"column":1},"end":{"line":55,"column":1}},"children":[{"type":"paragraph","children":[{"type":"strong","position":{"start":{"line":54,"column":1},"end":{"line":54,"column":1}},"children":[{"type":"text","value":"Doing","position":{"start":{"line":54,"column":1},"end":{"line":54,"column":1}},"key":"UJcpqFtecV"}],"key":"Zb1itmmHDv"},{"type":"text","value":" is a special list that I’ll explain later. It’s where cards go when I’m working on them currently.","position":{"start":{"line":54,"column":1},"end":{"line":54,"column":1}},"key":"PvV8R3N1sd"}],"key":"dpaZpRgVSY"}],"key":"yYvZYynO09"}],"key":"AyCLPDf7yq"},{"type":"paragraph","position":{"start":{"line":56,"column":1},"end":{"line":58,"column":1}},"children":[{"type":"text","value":"The other major component of the projcet board is a collection of “Done” lists. At the end of each\nweek, and cards that are finished get moved into a list named like so: ","position":{"start":{"line":56,"column":1},"end":{"line":56,"column":1}},"key":"eRegVXKQVJ"},{"type":"strong","position":{"start":{"line":56,"column":1},"end":{"line":56,"column":1}},"children":[{"type":"text","value":"Done - Week NN","position":{"start":{"line":56,"column":1},"end":{"line":56,"column":1}},"key":"FEPUCgVfI1"}],"key":"QD7W6WiKuN"},{"type":"text","value":" where “NN” is the\nnumber of the current week.","position":{"start":{"line":56,"column":1},"end":{"line":56,"column":1}},"key":"mkHRivTUXh"}],"key":"zLi3hsPAlB"},{"type":"paragraph","position":{"start":{"line":60,"column":1},"end":{"line":61,"column":1}},"children":[{"type":"text","value":"I keep a short-list of currently-active projects that I’m working on. These are “starred” and show up at\nthe top of the Trello board list to the left.","position":{"start":{"line":60,"column":1},"end":{"line":60,"column":1}},"key":"d3NPdsc5kN"}],"key":"APzwiRIziV"},{"type":"paragraph","position":{"start":{"line":63,"column":1},"end":{"line":63,"column":1}},"children":[{"type":"text","value":"Here’s an example of a project board:","position":{"start":{"line":63,"column":1},"end":{"line":63,"column":1}},"key":"OQTIptlb70"}],"key":"J2JHyYHIcJ"},{"type":"image","url":"/build/trello-board-project-a4d329044360b6751492004ec26b9d24.png","position":{"start":{"line":65,"column":1},"end":{"line":65,"column":1}},"key":"Bywn3Dcyuw","urlSource":"../../images/2018/trello-board-project.png"},{"type":"heading","depth":2,"position":{"start":{"line":68,"column":1},"end":{"line":68,"column":1}},"children":[{"type":"text","value":"Weekly board","position":{"start":{"line":68,"column":1},"end":{"line":68,"column":1}},"key":"q8CdpWFjhG"}],"identifier":"weekly-board","label":"Weekly board","html_id":"weekly-board","implicit":true,"key":"iAX1tEruKN"},{"type":"paragraph","position":{"start":{"line":70,"column":1},"end":{"line":72,"column":1}},"children":[{"type":"text","value":"The other major Trello board that I use is my “weekly” board. This is basically a to-do list for my week.\nIt’s got one list per project, and each card represents a to-do item for that project. There is one-to-one\nmapping between lists in this board and project boards that the cards come from.","position":{"start":{"line":70,"column":1},"end":{"line":70,"column":1}},"key":"w2WsVpIhAk"}],"key":"b5uG9Ku5ln"},{"type":"paragraph","position":{"start":{"line":74,"column":1},"end":{"line":75,"column":1}},"children":[{"type":"text","value":"As I work on cards throughout the week, I move them into another list called “Done”. Once the card is there,\nit means that I’ve finished that task for the week.","position":{"start":{"line":74,"column":1},"end":{"line":74,"column":1}},"key":"FbHEXeFN84"}],"key":"OklqTECkTw"},{"type":"paragraph","position":{"start":{"line":77,"column":1},"end":{"line":79,"column":1}},"children":[{"type":"text","value":"An additional component is that each card is assigned a number of ","position":{"start":{"line":77,"column":1},"end":{"line":77,"column":1}},"key":"Z5Y3ozSnmQ"},{"type":"strong","position":{"start":{"line":77,"column":1},"end":{"line":77,"column":1}},"children":[{"type":"text","value":"hours needed to complete the card","position":{"start":{"line":77,"column":1},"end":{"line":77,"column":1}},"key":"byvLi4wrLn"}],"key":"dq4ae8DPHW"},{"type":"text","value":".\nI try to keep the total number of hours on this board to <= 20. I’ve found that this is a realistic\nbalance between “enough hours to actually get stuff done” and “not so many hours that I won’t finish them”.","position":{"start":{"line":77,"column":1},"end":{"line":77,"column":1}},"key":"phJ3gdujx4"}],"key":"yIqT2lC9ZZ"},{"type":"paragraph","position":{"start":{"line":81,"column":1},"end":{"line":82,"column":1}},"children":[{"type":"text","value":"To assign and keep track of the hours with each card, I use a chrome extension called ","position":{"start":{"line":81,"column":1},"end":{"line":81,"column":1}},"key":"XtCW8z8Hyd"},{"type":"link","url":"https://chrome.google.com/webstore/detail/plus-for-trello-time-trac/gjjpophepkbhejnglcmkdnncmaanojkf?hl=en","position":{"start":{"line":81,"column":1},"end":{"line":81,"column":1}},"children":[{"type":"strong","position":{"start":{"line":81,"column":1},"end":{"line":81,"column":1}},"children":[{"type":"text","value":"Plus for Trello","position":{"start":{"line":81,"column":1},"end":{"line":81,"column":1}},"key":"D8VASPpjtF"}],"key":"LPoxzXTvh0"}],"urlSource":"https://chrome.google.com/webstore/detail/plus-for-trello-time-trac/gjjpophepkbhejnglcmkdnncmaanojkf?hl=en","key":"wS8g6I5Ivu"},{"type":"text","value":". This\nadds fields for “estimated” and “spent” hours that I update over the week.","position":{"start":{"line":81,"column":1},"end":{"line":81,"column":1}},"key":"Kwe2iwyQxm"}],"key":"H69oim2n8n"},{"type":"paragraph","position":{"start":{"line":84,"column":1},"end":{"line":84,"column":1}},"children":[{"type":"text","value":"Here’s an example of a weekly board:","position":{"start":{"line":84,"column":1},"end":{"line":84,"column":1}},"key":"mHTDH3deSy"}],"key":"Qy4niPK3Xz"},{"type":"image","url":"/build/trello-board-active-dcf101de93a65258663835485d6e02a1.png","position":{"start":{"line":86,"column":1},"end":{"line":86,"column":1}},"key":"DspZAI8QAq","urlSource":"../../images/2018/trello-board-active.png"},{"type":"heading","depth":2,"position":{"start":{"line":89,"column":1},"end":{"line":89,"column":1}},"children":[{"type":"text","value":"How does this work in practice?","position":{"start":{"line":89,"column":1},"end":{"line":89,"column":1}},"key":"Msl3RjfkSi"}],"identifier":"how-does-this-work-in-practice","label":"How does this work in practice?","html_id":"how-does-this-work-in-practice","implicit":true,"key":"cUVwhzyGRS"},{"type":"paragraph","position":{"start":{"line":91,"column":1},"end":{"line":92,"column":1}},"children":[{"type":"text","value":"I use a tool called ","position":{"start":{"line":91,"column":1},"end":{"line":91,"column":1}},"key":"yEoapksA8x"},{"type":"link","url":"https://butlerfortrello.com/","position":{"start":{"line":91,"column":1},"end":{"line":91,"column":1}},"children":[{"type":"strong","position":{"start":{"line":91,"column":1},"end":{"line":91,"column":1}},"children":[{"type":"text","value":"Butler for Trello","position":{"start":{"line":91,"column":1},"end":{"line":91,"column":1}},"key":"gRJyFjxCOU"}],"key":"mI5BTXvHT2"}],"urlSource":"https://butlerfortrello.com/","key":"mZFuJmW1Ry"},{"type":"text","value":" (BFT) to manage how cards flow through this system.\nLets you automate various tasks in Trello by writing messages that it parses as instructions.","position":{"start":{"line":91,"column":1},"end":{"line":91,"column":1}},"key":"SCkT77nfoc"}],"key":"zLeXzxFzaA"},{"type":"paragraph","position":{"start":{"line":94,"column":1},"end":{"line":95,"column":1}},"children":[{"type":"text","value":"Remember that “Doing” list that I mentioned in each project board? Any time I move a card into\na “Doing” list on a project board, the following happens:","position":{"start":{"line":94,"column":1},"end":{"line":94,"column":1}},"key":"flyhN5FBPy"}],"key":"bh3adzr71w"},{"type":"list","ordered":false,"spread":false,"position":{"start":{"line":97,"column":1},"end":{"line":99,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":97,"column":1},"end":{"line":97,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"BFT adds a custom field to the card that has the Project Board ID that it came from","position":{"start":{"line":97,"column":1},"end":{"line":97,"column":1}},"key":"TDEZ45CO8q"}],"key":"Y1LFFHrsIN"}],"key":"oRVqTgGxaA"},{"type":"listItem","spread":true,"position":{"start":{"line":98,"column":1},"end":{"line":99,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"BFT moves the card to the “weekly” board, to a list with the same name as the project board","position":{"start":{"line":98,"column":1},"end":{"line":98,"column":1}},"key":"X67AADhGmn"}],"key":"oTdkkNzcyz"}],"key":"vX8wPQ6uqw"}],"key":"Nc3RJq7p2E"},{"type":"paragraph","position":{"start":{"line":100,"column":1},"end":{"line":101,"column":1}},"children":[{"type":"text","value":"Moreover, remember that there was a “Done” list in my weekly board? That also does something\nspecial. I have a BFT link that, whenever clicked, does the following:","position":{"start":{"line":100,"column":1},"end":{"line":100,"column":1}},"key":"JzR2noMfXx"}],"key":"MAP1egVO14"},{"type":"list","ordered":false,"spread":false,"position":{"start":{"line":103,"column":1},"end":{"line":107,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":103,"column":1},"end":{"line":103,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Loop through every card in the “Done” list","position":{"start":{"line":103,"column":1},"end":{"line":103,"column":1}},"key":"ZSJlvNGrAd"}],"key":"uEIQfrqAGV"}],"key":"aOd1GCwbYo"},{"type":"listItem","spread":true,"position":{"start":{"line":104,"column":1},"end":{"line":104,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"For each card, find the Board ID that represents the board the card came from","position":{"start":{"line":104,"column":1},"end":{"line":104,"column":1}},"key":"RxACOg9JUe"}],"key":"nPBWfE5e9p"}],"key":"eRuDcXbH8n"},{"type":"listItem","spread":true,"position":{"start":{"line":105,"column":1},"end":{"line":107,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Move the card to that board, put it in a “Done” list that is automatically created using the\nnumber of the current active week.","position":{"start":{"line":105,"column":1},"end":{"line":105,"column":1}},"key":"rExrpfOMsu"}],"key":"hDdCEZhn8f"}],"key":"i7PYiq8Czx"}],"key":"RhxKMjUTlZ"},{"type":"paragraph","position":{"start":{"line":108,"column":1},"end":{"line":108,"column":1}},"children":[{"type":"text","value":"So, the general flow of cards through this system looks like this:","position":{"start":{"line":108,"column":1},"end":{"line":108,"column":1}},"key":"N0DD7trUGf"}],"key":"nKqXBTVQ4o"},{"type":"list","ordered":true,"start":1,"spread":false,"position":{"start":{"line":110,"column":1},"end":{"line":120,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":110,"column":1},"end":{"line":110,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Create cards in a project board that represent things to be done.","position":{"start":{"line":110,"column":1},"end":{"line":110,"column":1}},"key":"H3NNaNIPuJ"}],"key":"qffJ1BemPF"}],"key":"MW7BtumEsc"},{"type":"listItem","spread":true,"position":{"start":{"line":111,"column":1},"end":{"line":111,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"When it’s time to work on a task, move it to the “Doing” list","position":{"start":{"line":111,"column":1},"end":{"line":111,"column":1}},"key":"CcDfa4scJN"}],"key":"P2UMB1Zibc"}],"key":"CNDrF14hwH"},{"type":"listItem","spread":true,"position":{"start":{"line":112,"column":1},"end":{"line":112,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"BFT moves that card to my “Weekly” board, to a list w/ the project name","position":{"start":{"line":112,"column":1},"end":{"line":112,"column":1}},"key":"NweJsnPVut"}],"key":"jXTXsVSGPZ"}],"key":"oKWNkHBaJa"},{"type":"listItem","spread":true,"position":{"start":{"line":113,"column":1},"end":{"line":114,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"This happens at the beginning of the week, along with an estimation of the time needed for\neach card.","position":{"start":{"line":113,"column":1},"end":{"line":113,"column":1}},"key":"fnuYs6TeTV"}],"key":"fciU7qTmQ0"}],"key":"Xt6Bh5k2Yp"},{"type":"listItem","spread":true,"position":{"start":{"line":115,"column":1},"end":{"line":115,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"As the week progresses, I mark off the hours that I’ve spent on each card.","position":{"start":{"line":115,"column":1},"end":{"line":115,"column":1}},"key":"TLYbTiQNCB"}],"key":"Gj7smhQvoK"}],"key":"o7u0SVaVL0"},{"type":"listItem","spread":true,"position":{"start":{"line":116,"column":1},"end":{"line":116,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"When the card’s hours remaining reaches 0, I move it to the “Done” list","position":{"start":{"line":116,"column":1},"end":{"line":116,"column":1}},"key":"tA9WTaKLEX"}],"key":"EOPkmDSGkd"}],"key":"zaqjwGq0Pe"},{"type":"listItem","spread":true,"position":{"start":{"line":117,"column":1},"end":{"line":118,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"At the end of the week, I click my “board cleanup” link, and it returns each card to its\noriginal project board.","position":{"start":{"line":117,"column":1},"end":{"line":117,"column":1}},"key":"xH3Pe0TrwH"}],"key":"l0vuK8Q8JX"}],"key":"UluvQgqtN5"},{"type":"listItem","spread":true,"position":{"start":{"line":119,"column":1},"end":{"line":120,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Next week, I repeat this cycle.","position":{"start":{"line":119,"column":1},"end":{"line":119,"column":1}},"key":"Ua60LiLpRZ"}],"key":"v5Ab6FiiFJ"}],"key":"VBmoDw5k6p"}],"key":"orhrv7JfMp"},{"type":"paragraph","position":{"start":{"line":121,"column":1},"end":{"line":123,"column":1}},"children":[{"type":"text","value":"And that’s about it - I’ve found that this process is a nice way to keep both a high-level\nview of what needs to be done for my various projects (on each project board). It also allows\nmy to dig into specific to-do items throughout the week (on my weekly board).","position":{"start":{"line":121,"column":1},"end":{"line":121,"column":1}},"key":"cIliTAE0n4"}],"key":"D2BfYWuCea"},{"type":"paragraph","position":{"start":{"line":125,"column":1},"end":{"line":126,"column":1}},"children":[{"type":"text","value":"I’d love to hear feedback and thoughts about how other people manage their time throughout\nthe week! Hopefully some of you all find this useful.","position":{"start":{"line":125,"column":1},"end":{"line":125,"column":1}},"key":"RzAK500wl6"}],"key":"KTQmTqQsum"},{"type":"heading","depth":2,"position":{"start":{"line":128,"column":1},"end":{"line":128,"column":1}},"children":[{"type":"text","value":"Extras","position":{"start":{"line":128,"column":1},"end":{"line":128,"column":1}},"key":"WZETiEObRK"}],"identifier":"extras","label":"Extras","html_id":"extras","implicit":true,"key":"lgZh376Kvw"},{"type":"paragraph","position":{"start":{"line":130,"column":1},"end":{"line":131,"column":1}},"children":[{"type":"text","value":"Butler for Trello commands can be a little bit difficult to compose. Below I’ll post the\ntwo main commands that I use to handle all the card-moving described above.","position":{"start":{"line":130,"column":1},"end":{"line":130,"column":1}},"key":"dPFMkDmhXR"}],"key":"OcYryTptV6"},{"type":"heading","depth":3,"position":{"start":{"line":133,"column":1},"end":{"line":133,"column":1}},"children":[{"type":"text","value":"The weekly board","position":{"start":{"line":133,"column":1},"end":{"line":133,"column":1}},"key":"fe6lPslcjz"}],"identifier":"the-weekly-board","label":"The weekly board","html_id":"the-weekly-board","implicit":true,"key":"uQ6W8lohiV"},{"type":"paragraph","position":{"start":{"line":135,"column":1},"end":{"line":136,"column":1}},"children":[{"type":"text","value":"The weekly board has a “butler” list where the command is defined in a card (that’s how\nyou define board-specific BFT commands). Here’s the command:","position":{"start":{"line":135,"column":1},"end":{"line":135,"column":1}},"key":"zrLZL4DZak"}],"key":"b2xzevKnnh"},{"type":"paragraph","position":{"start":{"line":138,"column":1},"end":{"line":138,"column":1}},"children":[{"type":"text","value":"{% raw %}","position":{"start":{"line":138,"column":1},"end":{"line":138,"column":1}},"key":"wIfj4baR6p"}],"key":"au2RWgY0Js"},{"type":"code","lang":"","value":"script: for each card in list \"Return\", remove all labels and move the card to list \"Returned | Week {weeknumber}\" on board \"{{%homeboard}}\" and move list \"Returned | Week {weeknumber}\" on board \"{{%homeboard}}\" to position 1 and clear custom field \"homeboard\"","position":{"start":{"line":139,"column":1},"end":{"line":141,"column":1}},"key":"yIZbSi1OaP"},{"type":"paragraph","position":{"start":{"line":142,"column":1},"end":{"line":142,"column":1}},"children":[{"type":"text","value":"{% endraw %}","position":{"start":{"line":142,"column":1},"end":{"line":142,"column":1}},"key":"B4lPejD76f"}],"key":"I8jHMPIdvY"},{"type":"heading","depth":3,"position":{"start":{"line":144,"column":1},"end":{"line":144,"column":1}},"children":[{"type":"text","value":"A global command for project boards","position":{"start":{"line":144,"column":1},"end":{"line":144,"column":1}},"key":"zQ8IOV5hJs"}],"identifier":"a-global-command-for-project-boards","label":"A global command for project boards","html_id":"a-global-command-for-project-boards","implicit":true,"key":"NfboEhA6Yu"},{"type":"paragraph","position":{"start":{"line":146,"column":1},"end":{"line":147,"column":1}},"children":[{"type":"text","value":"I also use a global BFT command that moves the cards from each project board to the weekly\nboard when the card is moved to the “Doing” category.","position":{"start":{"line":146,"column":1},"end":{"line":146,"column":1}},"key":"dMGO4ZIojT"}],"key":"yggJOMqJ1N"},{"type":"code","lang":"","value":"when a card is added to list \"Doing\" by me, set custom field \"homeboard\" to \"{boardlink}\" and move the card to the top of list \"{boardname}\" on board \"Active\" and move list \"{boardname}\" on board \"Active\" to position 2","position":{"start":{"line":149,"column":1},"end":{"line":151,"column":1}},"key":"uxcpZ3GseM"}],"key":"cfRTLxd7Tj"}],"key":"VF0AcUETEC"},"references":{"cite":{"order":[],"data":{}}},"footer":{"navigation":{"prev":{"title":"Introducing makeitpop, a tool to perceptually warp your data!\"","url":"/blog/2018/makeitpop","group":"2018"},"next":{"title":"I like Rust’s governance structure","url":"/blog/2018/rust-governance","group":"2018"}}},"domain":"http://localhost:3000"}