 week.","position":{"start":{"line":74,"column":1},"end":{"line":74,"column":1}},"key":"Q91zF8ZXUC"}],"key":"lF1ZR0b25R"},{"type":"paragraph","position":{"start":{"line":77,"column":1},"end":{"line":79,"column":1}},"children":[{"type":"text","value":"An additional component is that each card is assigned a number of ","position":{"start":{"line":77,"column":1},"end":{"line":77,"column":1}},"key":"s6Q6vB4TAL"},{"type":"strong","position":{"start":{"line":77,"column":1},"end":{"line":77,"column":1}},"children":[{"type":"text","value":"hours needed to complete the card","position":{"start":{"line":77,"column":1},"end":{"line":77,"column":1}},"key":"RYtxx4BhTp"}],"key":"VWNeUQo063"},{"type":"text","value":".\nI try to keep the total number of hours on this board to <= 20. I’ve found that this is a realistic\nbalance between “enough hours to actually get stuff done” and “not so many hours that I won’t finish them”.","position":{"start":{"line":77,"column":1},"end":{"line":77,"column":1}},"key":"icS9FsMfnw"}],"key":"ToEuu8sSJQ"},{"type":"paragraph","position":{"start":{"line":81,"column":1},"end":{"line":82,"column":1}},"children":[{"type":"text","value":"To assign and keep track of the hours with each card, I use a chrome extension called ","position":{"start":{"line":81,"column":1},"end":{"line":81,"column":1}},"key":"OXlFkzzSiT"},{"type":"link","url":"https://chrome.google.com/webstore/detail/plus-for-trello-time-trac/gjjpophepkbhejnglcmkdnncmaanojkf?hl=en","position":{"start":{"line":81,"column":1},"end":{"line":81,"column":1}},"children":[{"type":"strong","position":{"start":{"line":81,"column":1},"end":{"line":81,"column":1}},"children":[{"type":"text","value":"Plus for Trello","position":{"start":{"line":81,"column":1},"end":{"line":81,"column":1}},"key":"M7oZzceLyY"}],"key":"V5s0NEC0QB"}],"urlSource":"https://chrome.google.com/webstore/detail/plus-for-trello-time-trac/gjjpophepkbhejnglcmkdnncmaanojkf?hl=en","key":"mxDVZRdQSm"},{"type":"text","value":". This\nadds fields for “estimated” and “spent” hours that I update over the week.","position":{"start":{"line":81,"column":1},"end":{"line":81,"column":1}},"key":"y3RKRP9ZOP"}],"key":"r19IqRIPc5"},{"type":"paragraph","position":{"start":{"line":84,"column":1},"end":{"line":84,"column":1}},"children":[{"type":"text","value":"Here’s an example of a weekly board:","position":{"start":{"line":84,"column":1},"end":{"line":84,"column":1}},"key":"H4QA0W2gFB"}],"key":"y6GGqT5dxS"},{"type":"image","url":"/build/trello-board-active-d1431e77b01ce5cf3cb85393151f4f9a.png","position":{"start":{"line":86,"column":1},"end":{"line":86,"column":1}},"key":"ZDf8H9LND7","urlSource":"../../images/2018/trello-board-active.png"},{"type":"heading","depth":2,"position":{"start":{"line":89,"column":1},"end":{"line":89,"column":1}},"children":[{"type":"text","value":"How does this work in practice?","position":{"start":{"line":89,"column":1},"end":{"line":89,"column":1}},"key":"W4a1PIT263"}],"identifier":"how-does-this-work-in-practice","label":"How does this work in practice?","html_id":"how-does-this-work-in-practice","implicit":true,"key":"oEc0eu4btg"},{"type":"paragraph","position":{"start":{"line":91,"column":1},"end":{"line":92,"column":1}},"children":[{"type":"text","value":"I use a tool called ","position":{"start":{"line":91,"column":1},"end":{"line":91,"column":1}},"key":"xw8PzCUaou"},{"type":"link","url":"https://butlerfortrello.com/","position":{"start":{"line":91,"column":1},"end":{"line":91,"column":1}},"children":[{"type":"strong","position":{"start":{"line":91,"column":1},"end":{"line":91,"column":1}},"children":[{"type":"text","value":"Butler for Trello","position":{"start":{"line":91,"column":1},"end":{"line":91,"column":1}},"key":"g7RwrARwJl"}],"key":"fGCXVWTtpV"}],"urlSource":"https://butlerfortrello.com/","key":"WW1vq1tlWh"},{"type":"text","value":" (BFT) to manage how cards flow through this system.\nLets you automate various tasks in Trello by writing messages that it parses as instructions.","position":{"start":{"line":91,"column":1},"end":{"line":91,"column":1}},"key":"fByikPntGM"}],"key":"FnGPdTpxKt"},{"type":"paragraph","position":{"start":{"line":94,"column":1},"end":{"line":95,"column":1}},"children":[{"type":"text","value":"Remember that “Doing” list that I mentioned in each project board? Any time I move a card into\na “Doing” list on a project board, the following happens:","position":{"start":{"line":94,"column":1},"end":{"line":94,"column":1}},"key":"jvZHWTz7I2"}],"key":"e0oChTgFcE"},{"type":"list","ordered":false,"spread":false,"position":{"start":{"line":97,"column":1},"end":{"line":99,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":97,"column":1},"end":{"line":97,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"BFT adds a custom field to the card that has the Project Board ID that it came from","position":{"start":{"line":97,"column":1},"end":{"line":97,"column":1}},"key":"F1gK9YvlBe"}],"key":"BwXlDJX88c"}],"key":"grbIiN9EHj"},{"type":"listItem","spread":true,"position":{"start":{"line":98,"column":1},"end":{"line":99,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"BFT moves the card to the “weekly” board, to a list with the same name as the project board","position":{"start":{"line":98,"column":1},"end":{"line":98,"column":1}},"key":"k3MDtqKprK"}],"key":"rOhSLtPxC5"}],"key":"WiXu7Bewb3"}],"key":"dG5YbaRtDK"},{"type":"paragraph","position":{"start":{"line":100,"column":1},"end":{"line":101,"column":1}},"children":[{"type":"text","value":"Moreover, remember that there was a “Done” list in my weekly board? That also does something\nspecial. I have a BFT link that, whenever clicked, does the following:","position":{"start":{"line":100,"column":1},"end":{"line":100,"column":1}},"key":"PRa7q0faXh"}],"key":"VGKDuoIkB1"},{"type":"list","ordered":false,"spread":false,"position":{"start":{"line":103,"column":1},"end":{"line":107,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":103,"column":1},"end":{"line":103,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Loop through every card in the “Done” list","position":{"start":{"line":103,"column":1},"end":{"line":103,"column":1}},"key":"H5QKhcMoHA"}],"key":"BX26WwkWOD"}],"key":"uLFcyWFFfA"},{"type":"listItem","spread":true,"position":{"start":{"line":104,"column":1},"end":{"line":104,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"For each card, find the Board ID that represents the board the card came from","position":{"start":{"line":104,"column":1},"end":{"line":104,"column":1}},"key":"uPR53obfa8"}],"key":"JQdyBNKtjZ"}],"key":"GNTy5LAeL0"},{"type":"listItem","spread":true,"position":{"start":{"line":105,"column":1},"end":{"line":107,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Move the card to that board, put it in a “Done” list that is automatically created using the\nnumber of the current active week.","position":{"start":{"line":105,"column":1},"end":{"line":105,"column":1}},"key":"ivDtDRDUPo"}],"key":"OAAyvqb0fA"}],"key":"Ddeu984OYi"}],"key":"wUBro22KdU"},{"type":"paragraph","position":{"start":{"line":108,"column":1},"end":{"line":108,"column":1}},"children":[{"type":"text","value":"So, the general flow of cards through this system looks like this:","position":{"start":{"line":108,"column":1},"end":{"line":108,"column":1}},"key":"AkDK21fmW5"}],"key":"vz7rFSNCdE"},{"type":"list","ordered":true,"start":1,"spread":false,"position":{"start":{"line":110,"column":1},"end":{"line":120,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":110,"column":1},"end":{"line":110,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Create cards in a project board that represent things to be done.","position":{"start":{"line":110,"column":1},"end":{"line":110,"column":1}},"key":"kRtvN2Na1k"}],"key":"jdegKCuvUS"}],"key":"AtqvU2d91k"},{"type":"listItem","spread":true,"position":{"start":{"line":111,"column":1},"end":{"line":111,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"When it’s time to work on a task, move it to the “Doing” list","position":{"start":{"line":111,"column":1},"end":{"line":111,"column":1}},"key":"iqxgDTeEeZ"}],"key":"NvKWqy972s"}],"key":"XAYiApKDCs"},{"type":"listItem","spread":true,"position":{"start":{"line":112,"column":1},"end":{"line":112,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"BFT moves that card to my “Weekly” board, to a list w/ the project name","position":{"start":{"line":112,"column":1},"end":{"line":112,"column":1}},"key":"Je40P5Gu88"}],"key":"wdsBSF8SDC"}],"key":"g7mXMXtEHd"},{"type":"listItem","spread":true,"position":{"start":{"line":113,"column":1},"end":{"line":114,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"This happens at the beginning of the week, along with an estimation of the time needed for\neach card.","position":{"start":{"line":113,"column":1},"end":{"line":113,"column":1}},"key":"EtviKgZtic"}],"key":"TuOJnzNl7p"}],"key":"eEbN1yjvDW"},{"type":"listItem","spread":true,"position":{"start":{"line":115,"column":1},"end":{"line":115,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"As the week progresses, I mark off the hours that I’ve spent on each card.","position":{"start":{"line":115,"column":1},"end":{"line":115,"column":1}},"key":"xd0WfJde9U"}],"key":"SGGfcD19vj"}],"key":"nURh1iBmYu"},{"type":"listItem","spread":true,"position":{"start":{"line":116,"column":1},"end":{"line":116,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"When the card’s hours remaining reaches 0, I move it to the “Done” list","position":{"start":{"line":116,"column":1},"end":{"line":116,"column":1}},"key":"wCuCKMQY6V"}],"key":"QgGoOPumQs"}],"key":"W6w9ccy2Sw"},{"type":"listItem","spread":true,"position":{"start":{"line":117,"column":1},"end":{"line":118,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"At the end of the week, I click my “board cleanup” link, and it returns each card to its\noriginal project board.","position":{"start":{"line":117,"column":1},"end":{"line":117,"column":1}},"key":"kqu0NM4PBe"}],"key":"s7LUYnsuau"}],"key":"dNLLuQAG9G"},{"type":"listItem","spread":true,"position":{"start":{"line":119,"column":1},"end":{"line":120,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Next week, I repeat this cycle.","position":{"start":{"line":119,"column":1},"end":{"line":119,"column":1}},"key":"ySLaMVIDUp"}],"key":"XjsA0d9GkR"}],"key":"t5RHhphahE"}],"key":"Ip2jgFgweo"},{"type":"paragraph","position":{"start":{"line":121,"column":1},"end":{"line":123,"column":1}},"children":[{"type":"text","value":"And that’s about it - I’ve found that this process is a nice way to keep both a high-level\nview of what needs to be done for my various projects (on each project board). It also allows\nmy to dig into specific to-do items throughout the week (on my weekly board).","position":{"start":{"line":121,"column":1},"end":{"line":121,"column":1}},"key":"qtI9ruaxSd"}],"key":"tTPh8mQ0vT"},{"type":"paragraph","position":{"start":{"line":125,"column":1},"end":{"line":126,"column":1}},"children":[{"type":"text","value":"I’d love to hear feedback and thoughts about how other people manage their time throughout\nthe week! Hopefully some of you all find this useful.","position":{"start":{"line":125,"column":1},"end":{"line":125,"column":1}},"key":"vmJ6SuuB2n"}],"key":"IlRp1TOkMO"},{"type":"heading","depth":2,"position":{"start":{"line":128,"column":1},"end":{"line":128,"column":1}},"children":[{"type":"text","value":"Extras","position":{"start":{"line":128,"column":1},"end":{"line":128,"column":1}},"key":"gcPcKHtmDx"}],"identifier":"extras","label":"Extras","html_id":"extras","implicit":true,"key":"GWJQcWWe2R"},{"type":"paragraph","position":{"start":{"line":130,"column":1},"end":{"line":131,"column":1}},"children":[{"type":"text","value":"Butler for Trello commands can be a little bit difficult to compose. Below I’ll post the\ntwo main commands that I use to handle all the card-moving described above.","position":{"start":{"line":130,"column":1},"end":{"line":130,"column":1}},"key":"dolqZIEDQq"}],"key":"aGTiItsWCM"},{"type":"heading","depth":3,"position":{"start":{"line":133,"column":1},"end":{"line":133,"column":1}},"children":[{"type":"text","value":"The weekly board","position":{"start":{"line":133,"column":1},"end":{"line":133,"column":1}},"key":"aL5XfA3Yxb"}],"identifier":"the-weekly-board","label":"The weekly board","html_id":"the-weekly-board","implicit":true,"key":"mYhVRbw5CX"},{"type":"paragraph","position":{"start":{"line":135,"column":1},"end":{"line":136,"column":1}},"children":[{"type":"text","value":"The weekly board has a “butler” list where the command is defined in a card (that’s how\nyou define board-specific BFT commands). Here’s the command:","position":{"start":{"line":135,"column":1},"end":{"line":135,"column":1}},"key":"gLOrrYKxH6"}],"key":"ryktDzVHOH"},{"type":"paragraph","position":{"start":{"line":138,"column":1},"end":{"line":138,"column":1}},"children":[{"type":"text","value":"{% raw %}","position":{"start":{"line":138,"column":1},"end":{"line":138,"column":1}},"key":"SdeMW2kAKU"}],"key":"iPtUYfdKqk"},{"type":"code","lang":"","value":"script: for each card in list \"Return\", remove all labels and move the card to list \"Returned | Week {weeknumber}\" on board \"{{%homeboard}}\" and move list \"Returned | Week {weeknumber}\" on board \"{{%homeboard}}\" to position 1 and clear custom field \"homeboard\"","position":{"start":{"line":139,"column":1},"end":{"line":141,"column":1}},"key":"Dpp8UO6ivN"},{"type":"paragraph","position":{"start":{"line":142,"column":1},"end":{"line":142,"column":1}},"children":[{"type":"text","value":"{% endraw %}","position":{"start":{"line":142,"column":1},"end":{"line":142,"column":1}},"key":"HZkItTd0aO"}],"key":"JLBVuHiimZ"},{"type":"heading","depth":3,"position":{"start":{"line":144,"column":1},"end":{"line":144,"column":1}},"children":[{"type":"text","value":"A global command for project boards","position":{"start":{"line":144,"column":1},"end":{"line":144,"column":1}},"key":"uaDo0YMKmZ"}],"identifier":"a-global-command-for-project-boards","label":"A global command for project boards","html_id":"a-global-command-for-project-boards","implicit":true,"key":"DW9bLzMhj8"},{"type":"paragraph","position":{"start":{"line":146,"column":1},"end":{"line":147,"column":1}},"children":[{"type":"text","value":"I also use a global BFT command that moves the cards from each project board to the weekly\nboard when the card is moved to the “Doing” category.","position":{"start":{"line":146,"column":1},"end":{"line":146,"column":1}},"key":"Zb4bKfltnj"}],"key":"cJJSOn0HpI"},{"type":"code","lang":"","value":"when a card is added to list \"Doing\" by me, set custom field \"homeboard\" to \"{boardlink}\" and move the card to the top of list \"{boardname}\" on board \"Active\" and move list \"{boardname}\" on board \"Active\" to position 2","position":{"start":{"line":149,"column":1},"end":{"line":151,"column":1}},"key":"casfBznP8A"}],"key":"x9ejoMXZ2p"}],"key":"go1wdhU61Z"},"references":{"cite":{"order":[],"data":{}}},"footer":{"navigation":{"prev":{"title":"Introducing makeitpop, a tool to perceptually warp your data!\"","url":"/blog/2018/makeitpop","group":"2018"},"next":{"title":"I like Rust’s governance structure","url":"/blog/2018/rust-governance","group":"2018"}}},"domain":"http://localhost:3000"}