 week.","position":{"start":{"line":74,"column":1},"end":{"line":74,"column":1}},"key":"Ydf2unXBGL"}],"key":"j3FYMjJVyf"},{"type":"paragraph","position":{"start":{"line":77,"column":1},"end":{"line":79,"column":1}},"children":[{"type":"text","value":"An additional component is that each card is assigned a number of ","position":{"start":{"line":77,"column":1},"end":{"line":77,"column":1}},"key":"eKKnHtpQfN"},{"type":"strong","position":{"start":{"line":77,"column":1},"end":{"line":77,"column":1}},"children":[{"type":"text","value":"hours needed to complete the card","position":{"start":{"line":77,"column":1},"end":{"line":77,"column":1}},"key":"UXLppMbFtX"}],"key":"CjgYE1vgvj"},{"type":"text","value":".\nI try to keep the total number of hours on this board to <= 20. I’ve found that this is a realistic\nbalance between “enough hours to actually get stuff done” and “not so many hours that I won’t finish them”.","position":{"start":{"line":77,"column":1},"end":{"line":77,"column":1}},"key":"amVrZHtJug"}],"key":"RAhL9kaois"},{"type":"paragraph","position":{"start":{"line":81,"column":1},"end":{"line":82,"column":1}},"children":[{"type":"text","value":"To assign and keep track of the hours with each card, I use a chrome extension called ","position":{"start":{"line":81,"column":1},"end":{"line":81,"column":1}},"key":"s3WxnKUpH3"},{"type":"link","url":"https://chrome.google.com/webstore/detail/plus-for-trello-time-trac/gjjpophepkbhejnglcmkdnncmaanojkf?hl=en","position":{"start":{"line":81,"column":1},"end":{"line":81,"column":1}},"children":[{"type":"strong","position":{"start":{"line":81,"column":1},"end":{"line":81,"column":1}},"children":[{"type":"text","value":"Plus for Trello","position":{"start":{"line":81,"column":1},"end":{"line":81,"column":1}},"key":"ENO4YM8p49"}],"key":"Jb3qafI9Ao"}],"urlSource":"https://chrome.google.com/webstore/detail/plus-for-trello-time-trac/gjjpophepkbhejnglcmkdnncmaanojkf?hl=en","key":"RBMqCAnXvN"},{"type":"text","value":". This\nadds fields for “estimated” and “spent” hours that I update over the week.","position":{"start":{"line":81,"column":1},"end":{"line":81,"column":1}},"key":"p0sowCK72S"}],"key":"Wh02C7vK7K"},{"type":"paragraph","position":{"start":{"line":84,"column":1},"end":{"line":84,"column":1}},"children":[{"type":"text","value":"Here’s an example of a weekly board:","position":{"start":{"line":84,"column":1},"end":{"line":84,"column":1}},"key":"oUHgPHETms"}],"key":"zmwGup0FtM"},{"type":"image","url":"/build/trello-board-active-34c0de44a43316f88069b605ba3162a8.png","position":{"start":{"line":86,"column":1},"end":{"line":86,"column":1}},"key":"PlW2pwugCS","urlSource":"../../images/2018/trello-board-active.png"},{"type":"heading","depth":2,"position":{"start":{"line":89,"column":1},"end":{"line":89,"column":1}},"children":[{"type":"text","value":"How does this work in practice?","position":{"start":{"line":89,"column":1},"end":{"line":89,"column":1}},"key":"UmwFl3lj2G"}],"identifier":"how-does-this-work-in-practice","label":"How does this work in practice?","html_id":"how-does-this-work-in-practice","implicit":true,"key":"deejDKAjE0"},{"type":"paragraph","position":{"start":{"line":91,"column":1},"end":{"line":92,"column":1}},"children":[{"type":"text","value":"I use a tool called ","position":{"start":{"line":91,"column":1},"end":{"line":91,"column":1}},"key":"Gc0KRd7obD"},{"type":"link","url":"https://butlerfortrello.com/","position":{"start":{"line":91,"column":1},"end":{"line":91,"column":1}},"children":[{"type":"strong","position":{"start":{"line":91,"column":1},"end":{"line":91,"column":1}},"children":[{"type":"text","value":"Butler for Trello","position":{"start":{"line":91,"column":1},"end":{"line":91,"column":1}},"key":"ZRGSAncaxe"}],"key":"TOJ0oziqJH"}],"urlSource":"https://butlerfortrello.com/","key":"itOOb9s3eG"},{"type":"text","value":" (BFT) to manage how cards flow through this system.\nLets you automate various tasks in Trello by writing messages that it parses as instructions.","position":{"start":{"line":91,"column":1},"end":{"line":91,"column":1}},"key":"o8XW25ZtfY"}],"key":"z3A5uZTTa2"},{"type":"paragraph","position":{"start":{"line":94,"column":1},"end":{"line":95,"column":1}},"children":[{"type":"text","value":"Remember that “Doing” list that I mentioned in each project board? Any time I move a card into\na “Doing” list on a project board, the following happens:","position":{"start":{"line":94,"column":1},"end":{"line":94,"column":1}},"key":"jz05kXgD8L"}],"key":"T2tyrkCPRx"},{"type":"list","ordered":false,"spread":false,"position":{"start":{"line":97,"column":1},"end":{"line":99,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":97,"column":1},"end":{"line":97,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"BFT adds a custom field to the card that has the Project Board ID that it came from","position":{"start":{"line":97,"column":1},"end":{"line":97,"column":1}},"key":"MiZkFZI20S"}],"key":"mnq1SjTeET"}],"key":"yeXQaeADEB"},{"type":"listItem","spread":true,"position":{"start":{"line":98,"column":1},"end":{"line":99,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"BFT moves the card to the “weekly” board, to a list with the same name as the project board","position":{"start":{"line":98,"column":1},"end":{"line":98,"column":1}},"key":"eURtZAMz5M"}],"key":"QisN6sIYv6"}],"key":"lZZUgM3oeO"}],"key":"AndhkwttZQ"},{"type":"paragraph","position":{"start":{"line":100,"column":1},"end":{"line":101,"column":1}},"children":[{"type":"text","value":"Moreover, remember that there was a “Done” list in my weekly board? That also does something\nspecial. I have a BFT link that, whenever clicked, does the following:","position":{"start":{"line":100,"column":1},"end":{"line":100,"column":1}},"key":"CySxab7A0B"}],"key":"vn3wMbQTxb"},{"type":"list","ordered":false,"spread":false,"position":{"start":{"line":103,"column":1},"end":{"line":107,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":103,"column":1},"end":{"line":103,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Loop through every card in the “Done” list","position":{"start":{"line":103,"column":1},"end":{"line":103,"column":1}},"key":"gXPkSmQg7E"}],"key":"B35aSAv36U"}],"key":"plbzzHrTUb"},{"type":"listItem","spread":true,"position":{"start":{"line":104,"column":1},"end":{"line":104,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"For each card, find the Board ID that represents the board the card came from","position":{"start":{"line":104,"column":1},"end":{"line":104,"column":1}},"key":"yL1gLfMRoe"}],"key":"FAnFCKmnbX"}],"key":"EBwj5Na4iZ"},{"type":"listItem","spread":true,"position":{"start":{"line":105,"column":1},"end":{"line":107,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Move the card to that board, put it in a “Done” list that is automatically created using the\nnumber of the current active week.","position":{"start":{"line":105,"column":1},"end":{"line":105,"column":1}},"key":"k3aJz2utyA"}],"key":"GpoJo9uvCU"}],"key":"KqmNFPrjbB"}],"key":"c7gHmhMj3K"},{"type":"paragraph","position":{"start":{"line":108,"column":1},"end":{"line":108,"column":1}},"children":[{"type":"text","value":"So, the general flow of cards through this system looks like this:","position":{"start":{"line":108,"column":1},"end":{"line":108,"column":1}},"key":"cOMrhxpzss"}],"key":"LOmPiJMXjD"},{"type":"list","ordered":true,"start":1,"spread":false,"position":{"start":{"line":110,"column":1},"end":{"line":120,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":110,"column":1},"end":{"line":110,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Create cards in a project board that represent things to be done.","position":{"start":{"line":110,"column":1},"end":{"line":110,"column":1}},"key":"lEEWqS2Twa"}],"key":"fxDy2Y9ZBN"}],"key":"safg06FtfJ"},{"type":"listItem","spread":true,"position":{"start":{"line":111,"column":1},"end":{"line":111,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"When it’s time to work on a task, move it to the “Doing” list","position":{"start":{"line":111,"column":1},"end":{"line":111,"column":1}},"key":"j68REJLAIQ"}],"key":"D8tDBwP5JQ"}],"key":"TO3cm63pVA"},{"type":"listItem","spread":true,"position":{"start":{"line":112,"column":1},"end":{"line":112,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"BFT moves that card to my “Weekly” board, to a list w/ the project name","position":{"start":{"line":112,"column":1},"end":{"line":112,"column":1}},"key":"WYyLt2xQO1"}],"key":"FkihC2dTYW"}],"key":"LwPFPK90ed"},{"type":"listItem","spread":true,"position":{"start":{"line":113,"column":1},"end":{"line":114,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"This happens at the beginning of the week, along with an estimation of the time needed for\neach card.","position":{"start":{"line":113,"column":1},"end":{"line":113,"column":1}},"key":"NqGc6JVcht"}],"key":"r5INAQq3zA"}],"key":"GECYeMgjxk"},{"type":"listItem","spread":true,"position":{"start":{"line":115,"column":1},"end":{"line":115,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"As the week progresses, I mark off the hours that I’ve spent on each card.","position":{"start":{"line":115,"column":1},"end":{"line":115,"column":1}},"key":"rpFWBYaOhB"}],"key":"olG2ZwoueW"}],"key":"ZSjyuSBtMO"},{"type":"listItem","spread":true,"position":{"start":{"line":116,"column":1},"end":{"line":116,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"When the card’s hours remaining reaches 0, I move it to the “Done” list","position":{"start":{"line":116,"column":1},"end":{"line":116,"column":1}},"key":"yoyrwZ9K3Q"}],"key":"SQpwI2biaX"}],"key":"nyGbDdbe9B"},{"type":"listItem","spread":true,"position":{"start":{"line":117,"column":1},"end":{"line":118,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"At the end of the week, I click my “board cleanup” link, and it returns each card to its\noriginal project board.","position":{"start":{"line":117,"column":1},"end":{"line":117,"column":1}},"key":"G2hjNun6D6"}],"key":"KeJfso0MKD"}],"key":"G3UTac2t67"},{"type":"listItem","spread":true,"position":{"start":{"line":119,"column":1},"end":{"line":120,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Next week, I repeat this cycle.","position":{"start":{"line":119,"column":1},"end":{"line":119,"column":1}},"key":"Bwh8mXI1kJ"}],"key":"Qwy5NMPdzZ"}],"key":"tGBb6mQ7s5"}],"key":"pLKhOZ5Aem"},{"type":"paragraph","position":{"start":{"line":121,"column":1},"end":{"line":123,"column":1}},"children":[{"type":"text","value":"And that’s about it - I’ve found that this process is a nice way to keep both a high-level\nview of what needs to be done for my various projects (on each project board). It also allows\nmy to dig into specific to-do items throughout the week (on my weekly board).","position":{"start":{"line":121,"column":1},"end":{"line":121,"column":1}},"key":"yNJvV0IYX5"}],"key":"SCs1EPdXRY"},{"type":"paragraph","position":{"start":{"line":125,"column":1},"end":{"line":126,"column":1}},"children":[{"type":"text","value":"I’d love to hear feedback and thoughts about how other people manage their time throughout\nthe week! Hopefully some of you all find this useful.","position":{"start":{"line":125,"column":1},"end":{"line":125,"column":1}},"key":"uOhzs6zSmG"}],"key":"TNIbWIJfzG"},{"type":"heading","depth":2,"position":{"start":{"line":128,"column":1},"end":{"line":128,"column":1}},"children":[{"type":"text","value":"Extras","position":{"start":{"line":128,"column":1},"end":{"line":128,"column":1}},"key":"GsNe0DNz9V"}],"identifier":"extras","label":"Extras","html_id":"extras","implicit":true,"key":"jvjL6yXjyo"},{"type":"paragraph","position":{"start":{"line":130,"column":1},"end":{"line":131,"column":1}},"children":[{"type":"text","value":"Butler for Trello commands can be a little bit difficult to compose. Below I’ll post the\ntwo main commands that I use to handle all the card-moving described above.","position":{"start":{"line":130,"column":1},"end":{"line":130,"column":1}},"key":"eYbve5nrhA"}],"key":"VWFm3TiXGp"},{"type":"heading","depth":3,"position":{"start":{"line":133,"column":1},"end":{"line":133,"column":1}},"children":[{"type":"text","value":"The weekly board","position":{"start":{"line":133,"column":1},"end":{"line":133,"column":1}},"key":"RwBINljmTk"}],"identifier":"the-weekly-board","label":"The weekly board","html_id":"the-weekly-board","implicit":true,"key":"x8andKzbcv"},{"type":"paragraph","position":{"start":{"line":135,"column":1},"end":{"line":136,"column":1}},"children":[{"type":"text","value":"The weekly board has a “butler” list where the command is defined in a card (that’s how\nyou define board-specific BFT commands). Here’s the command:","position":{"start":{"line":135,"column":1},"end":{"line":135,"column":1}},"key":"H84aIJZSzv"}],"key":"koDpfL5pWt"},{"type":"paragraph","position":{"start":{"line":138,"column":1},"end":{"line":138,"column":1}},"children":[{"type":"text","value":"{% raw %}","position":{"start":{"line":138,"column":1},"end":{"line":138,"column":1}},"key":"IqcCnu4zfc"}],"key":"pCQ7Ef58iV"},{"type":"code","lang":"","value":"script: for each card in list \"Return\", remove all labels and move the card to list \"Returned | Week {weeknumber}\" on board \"{{%homeboard}}\" and move list \"Returned | Week {weeknumber}\" on board \"{{%homeboard}}\" to position 1 and clear custom field \"homeboard\"","position":{"start":{"line":139,"column":1},"end":{"line":141,"column":1}},"key":"K44fDK5Wiz"},{"type":"paragraph","position":{"start":{"line":142,"column":1},"end":{"line":142,"column":1}},"children":[{"type":"text","value":"{% endraw %}","position":{"start":{"line":142,"column":1},"end":{"line":142,"column":1}},"key":"Wjx4nyHWez"}],"key":"V95NHs7yPw"},{"type":"heading","depth":3,"position":{"start":{"line":144,"column":1},"end":{"line":144,"column":1}},"children":[{"type":"text","value":"A global command for project boards","position":{"start":{"line":144,"column":1},"end":{"line":144,"column":1}},"key":"pN2tM9yvEB"}],"identifier":"a-global-command-for-project-boards","label":"A global command for project boards","html_id":"a-global-command-for-project-boards","implicit":true,"key":"M8o8UTOiBv"},{"type":"paragraph","position":{"start":{"line":146,"column":1},"end":{"line":147,"column":1}},"children":[{"type":"text","value":"I also use a global BFT command that moves the cards from each project board to the weekly\nboard when the card is moved to the “Doing” category.","position":{"start":{"line":146,"column":1},"end":{"line":146,"column":1}},"key":"dGqjC63qNB"}],"key":"tFd5bfD5AA"},{"type":"code","lang":"","value":"when a card is added to list \"Doing\" by me, set custom field \"homeboard\" to \"{boardlink}\" and move the card to the top of list \"{boardname}\" on board \"Active\" and move list \"{boardname}\" on board \"Active\" to position 2","position":{"start":{"line":149,"column":1},"end":{"line":151,"column":1}},"key":"JzyG62kCuP"}],"key":"Mt5aHoOaxx"}],"key":"wAKMiwp1M1"},"references":{"cite":{"order":[],"data":{}}},"footer":{"navigation":{"prev":{"title":"Introducing makeitpop, a tool to perceptually warp your data!\"","url":"/blog/2018/makeitpop","group":"2018"},"next":{"title":"I like Rust’s governance structure","url":"/blog/2018/rust-governance","group":"2018"}}},"domain":"http://localhost:3000"}