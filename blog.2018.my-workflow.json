 week.","position":{"start":{"line":74,"column":1},"end":{"line":74,"column":1}},"key":"lcNrR65SCU"}],"key":"RelglLGsj6"},{"type":"paragraph","position":{"start":{"line":77,"column":1},"end":{"line":79,"column":1}},"children":[{"type":"text","value":"An additional component is that each card is assigned a number of ","position":{"start":{"line":77,"column":1},"end":{"line":77,"column":1}},"key":"RiAsoe1O2i"},{"type":"strong","position":{"start":{"line":77,"column":1},"end":{"line":77,"column":1}},"children":[{"type":"text","value":"hours needed to complete the card","position":{"start":{"line":77,"column":1},"end":{"line":77,"column":1}},"key":"gQCaVuNXZd"}],"key":"ejBUNiENex"},{"type":"text","value":".\nI try to keep the total number of hours on this board to <= 20. I’ve found that this is a realistic\nbalance between “enough hours to actually get stuff done” and “not so many hours that I won’t finish them”.","position":{"start":{"line":77,"column":1},"end":{"line":77,"column":1}},"key":"XJS83Y7p2e"}],"key":"sI1VEPvpMP"},{"type":"paragraph","position":{"start":{"line":81,"column":1},"end":{"line":82,"column":1}},"children":[{"type":"text","value":"To assign and keep track of the hours with each card, I use a chrome extension called ","position":{"start":{"line":81,"column":1},"end":{"line":81,"column":1}},"key":"ZwR0sbwl5z"},{"type":"link","url":"https://chrome.google.com/webstore/detail/plus-for-trello-time-trac/gjjpophepkbhejnglcmkdnncmaanojkf?hl=en","position":{"start":{"line":81,"column":1},"end":{"line":81,"column":1}},"children":[{"type":"strong","position":{"start":{"line":81,"column":1},"end":{"line":81,"column":1}},"children":[{"type":"text","value":"Plus for Trello","position":{"start":{"line":81,"column":1},"end":{"line":81,"column":1}},"key":"cZQhR2tiRN"}],"key":"lWyvqLUGep"}],"urlSource":"https://chrome.google.com/webstore/detail/plus-for-trello-time-trac/gjjpophepkbhejnglcmkdnncmaanojkf?hl=en","key":"yRlF4FMuz7"},{"type":"text","value":". This\nadds fields for “estimated” and “spent” hours that I update over the week.","position":{"start":{"line":81,"column":1},"end":{"line":81,"column":1}},"key":"uvxSuit96J"}],"key":"jO4aDrZHVp"},{"type":"paragraph","position":{"start":{"line":84,"column":1},"end":{"line":84,"column":1}},"children":[{"type":"text","value":"Here’s an example of a weekly board:","position":{"start":{"line":84,"column":1},"end":{"line":84,"column":1}},"key":"uox0bODxTL"}],"key":"q4N0HBR7e9"},{"type":"image","url":"/build/trello-board-active-a95a8e92d374bcdf5c3d7b59be4890b1.png","position":{"start":{"line":86,"column":1},"end":{"line":86,"column":1}},"key":"voDEQyuF6H","urlSource":"../../images/2018/trello-board-active.png"},{"type":"heading","depth":2,"position":{"start":{"line":89,"column":1},"end":{"line":89,"column":1}},"children":[{"type":"text","value":"How does this work in practice?","position":{"start":{"line":89,"column":1},"end":{"line":89,"column":1}},"key":"LZ8UAmmfsQ"}],"identifier":"how-does-this-work-in-practice","label":"How does this work in practice?","html_id":"how-does-this-work-in-practice","implicit":true,"key":"AX6SzHTtey"},{"type":"paragraph","position":{"start":{"line":91,"column":1},"end":{"line":92,"column":1}},"children":[{"type":"text","value":"I use a tool called ","position":{"start":{"line":91,"column":1},"end":{"line":91,"column":1}},"key":"AsAigmYKtb"},{"type":"link","url":"https://butlerfortrello.com/","position":{"start":{"line":91,"column":1},"end":{"line":91,"column":1}},"children":[{"type":"strong","position":{"start":{"line":91,"column":1},"end":{"line":91,"column":1}},"children":[{"type":"text","value":"Butler for Trello","position":{"start":{"line":91,"column":1},"end":{"line":91,"column":1}},"key":"xW5d5EUdKu"}],"key":"ZU4fGdUocS"}],"urlSource":"https://butlerfortrello.com/","key":"fI3SrUUkbH"},{"type":"text","value":" (BFT) to manage how cards flow through this system.\nLets you automate various tasks in Trello by writing messages that it parses as instructions.","position":{"start":{"line":91,"column":1},"end":{"line":91,"column":1}},"key":"oBDo945rt1"}],"key":"QE5X2vdrhy"},{"type":"paragraph","position":{"start":{"line":94,"column":1},"end":{"line":95,"column":1}},"children":[{"type":"text","value":"Remember that “Doing” list that I mentioned in each project board? Any time I move a card into\na “Doing” list on a project board, the following happens:","position":{"start":{"line":94,"column":1},"end":{"line":94,"column":1}},"key":"xN4GbtbuMr"}],"key":"h6zR0iZhSJ"},{"type":"list","ordered":false,"spread":false,"position":{"start":{"line":97,"column":1},"end":{"line":99,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":97,"column":1},"end":{"line":97,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"BFT adds a custom field to the card that has the Project Board ID that it came from","position":{"start":{"line":97,"column":1},"end":{"line":97,"column":1}},"key":"CnUuMDCqGD"}],"key":"RqO9wsbeTX"}],"key":"XeXNWqeQZ3"},{"type":"listItem","spread":true,"position":{"start":{"line":98,"column":1},"end":{"line":99,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"BFT moves the card to the “weekly” board, to a list with the same name as the project board","position":{"start":{"line":98,"column":1},"end":{"line":98,"column":1}},"key":"UrM1xYmTdP"}],"key":"ALtiAQSpEb"}],"key":"wP8cPX2VIY"}],"key":"iuIF2iPX98"},{"type":"paragraph","position":{"start":{"line":100,"column":1},"end":{"line":101,"column":1}},"children":[{"type":"text","value":"Moreover, remember that there was a “Done” list in my weekly board? That also does something\nspecial. I have a BFT link that, whenever clicked, does the following:","position":{"start":{"line":100,"column":1},"end":{"line":100,"column":1}},"key":"IA8FfKF3f6"}],"key":"kaNqx3llRM"},{"type":"list","ordered":false,"spread":false,"position":{"start":{"line":103,"column":1},"end":{"line":107,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":103,"column":1},"end":{"line":103,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Loop through every card in the “Done” list","position":{"start":{"line":103,"column":1},"end":{"line":103,"column":1}},"key":"MJPYFzlr2B"}],"key":"UydBfzM7hU"}],"key":"p41oWqiIZ6"},{"type":"listItem","spread":true,"position":{"start":{"line":104,"column":1},"end":{"line":104,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"For each card, find the Board ID that represents the board the card came from","position":{"start":{"line":104,"column":1},"end":{"line":104,"column":1}},"key":"EHNxXD7deC"}],"key":"VCKjIzYPam"}],"key":"ViOM3bmQYc"},{"type":"listItem","spread":true,"position":{"start":{"line":105,"column":1},"end":{"line":107,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Move the card to that board, put it in a “Done” list that is automatically created using the\nnumber of the current active week.","position":{"start":{"line":105,"column":1},"end":{"line":105,"column":1}},"key":"q2w14dFFHw"}],"key":"wGoVqWov20"}],"key":"GHHWpBI2sz"}],"key":"OAsZixyJC0"},{"type":"paragraph","position":{"start":{"line":108,"column":1},"end":{"line":108,"column":1}},"children":[{"type":"text","value":"So, the general flow of cards through this system looks like this:","position":{"start":{"line":108,"column":1},"end":{"line":108,"column":1}},"key":"fAILSHYxgJ"}],"key":"D1uzQ3yrzF"},{"type":"list","ordered":true,"start":1,"spread":false,"position":{"start":{"line":110,"column":1},"end":{"line":120,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":110,"column":1},"end":{"line":110,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Create cards in a project board that represent things to be done.","position":{"start":{"line":110,"column":1},"end":{"line":110,"column":1}},"key":"g2JGJOUkR7"}],"key":"HiU24BMp4h"}],"key":"F2PXODtaA9"},{"type":"listItem","spread":true,"position":{"start":{"line":111,"column":1},"end":{"line":111,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"When it’s time to work on a task, move it to the “Doing” list","position":{"start":{"line":111,"column":1},"end":{"line":111,"column":1}},"key":"G2plaLrSYq"}],"key":"vISrXvApXY"}],"key":"mJzDPZpoyS"},{"type":"listItem","spread":true,"position":{"start":{"line":112,"column":1},"end":{"line":112,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"BFT moves that card to my “Weekly” board, to a list w/ the project name","position":{"start":{"line":112,"column":1},"end":{"line":112,"column":1}},"key":"zMdd52oYUs"}],"key":"JMVlsuLmj0"}],"key":"dmju1ze790"},{"type":"listItem","spread":true,"position":{"start":{"line":113,"column":1},"end":{"line":114,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"This happens at the beginning of the week, along with an estimation of the time needed for\neach card.","position":{"start":{"line":113,"column":1},"end":{"line":113,"column":1}},"key":"lkOH83ie8u"}],"key":"KpUQasks7O"}],"key":"hiflXm6ocO"},{"type":"listItem","spread":true,"position":{"start":{"line":115,"column":1},"end":{"line":115,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"As the week progresses, I mark off the hours that I’ve spent on each card.","position":{"start":{"line":115,"column":1},"end":{"line":115,"column":1}},"key":"JHdhZCdJAE"}],"key":"cwwRjwapYo"}],"key":"iZSjvRvuGI"},{"type":"listItem","spread":true,"position":{"start":{"line":116,"column":1},"end":{"line":116,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"When the card’s hours remaining reaches 0, I move it to the “Done” list","position":{"start":{"line":116,"column":1},"end":{"line":116,"column":1}},"key":"cvMumtl7ju"}],"key":"w5Xk3QZoK4"}],"key":"C39AZsKryt"},{"type":"listItem","spread":true,"position":{"start":{"line":117,"column":1},"end":{"line":118,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"At the end of the week, I click my “board cleanup” link, and it returns each card to its\noriginal project board.","position":{"start":{"line":117,"column":1},"end":{"line":117,"column":1}},"key":"F1QdWjYz5Q"}],"key":"vt2hts9eVw"}],"key":"qavA5nUcSJ"},{"type":"listItem","spread":true,"position":{"start":{"line":119,"column":1},"end":{"line":120,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Next week, I repeat this cycle.","position":{"start":{"line":119,"column":1},"end":{"line":119,"column":1}},"key":"yqH7wTq2mH"}],"key":"yBJ29Ln9Ls"}],"key":"L9enAYdNBv"}],"key":"CBaqMTPC4P"},{"type":"paragraph","position":{"start":{"line":121,"column":1},"end":{"line":123,"column":1}},"children":[{"type":"text","value":"And that’s about it - I’ve found that this process is a nice way to keep both a high-level\nview of what needs to be done for my various projects (on each project board). It also allows\nmy to dig into specific to-do items throughout the week (on my weekly board).","position":{"start":{"line":121,"column":1},"end":{"line":121,"column":1}},"key":"zZ6Jt9H4rX"}],"key":"owc56xs1r8"},{"type":"paragraph","position":{"start":{"line":125,"column":1},"end":{"line":126,"column":1}},"children":[{"type":"text","value":"I’d love to hear feedback and thoughts about how other people manage their time throughout\nthe week! Hopefully some of you all find this useful.","position":{"start":{"line":125,"column":1},"end":{"line":125,"column":1}},"key":"fMF5Gq43gR"}],"key":"v0Zr2jXdbb"},{"type":"heading","depth":2,"position":{"start":{"line":128,"column":1},"end":{"line":128,"column":1}},"children":[{"type":"text","value":"Extras","position":{"start":{"line":128,"column":1},"end":{"line":128,"column":1}},"key":"fTK7ZweTmA"}],"identifier":"extras","label":"Extras","html_id":"extras","implicit":true,"key":"xFfIY9oWQQ"},{"type":"paragraph","position":{"start":{"line":130,"column":1},"end":{"line":131,"column":1}},"children":[{"type":"text","value":"Butler for Trello commands can be a little bit difficult to compose. Below I’ll post the\ntwo main commands that I use to handle all the card-moving described above.","position":{"start":{"line":130,"column":1},"end":{"line":130,"column":1}},"key":"xgcl4i8XTn"}],"key":"EV16e1qwrm"},{"type":"heading","depth":3,"position":{"start":{"line":133,"column":1},"end":{"line":133,"column":1}},"children":[{"type":"text","value":"The weekly board","position":{"start":{"line":133,"column":1},"end":{"line":133,"column":1}},"key":"ZlcW1igy0P"}],"identifier":"the-weekly-board","label":"The weekly board","html_id":"the-weekly-board","implicit":true,"key":"nCoYVq6oEy"},{"type":"paragraph","position":{"start":{"line":135,"column":1},"end":{"line":136,"column":1}},"children":[{"type":"text","value":"The weekly board has a “butler” list where the command is defined in a card (that’s how\nyou define board-specific BFT commands). Here’s the command:","position":{"start":{"line":135,"column":1},"end":{"line":135,"column":1}},"key":"wS0R4nRY4Z"}],"key":"ngisLdcgf5"},{"type":"paragraph","position":{"start":{"line":138,"column":1},"end":{"line":138,"column":1}},"children":[{"type":"text","value":"{% raw %}","position":{"start":{"line":138,"column":1},"end":{"line":138,"column":1}},"key":"ZYqG9CEEAG"}],"key":"nycfX0ST9o"},{"type":"code","lang":"","value":"script: for each card in list \"Return\", remove all labels and move the card to list \"Returned | Week {weeknumber}\" on board \"{{%homeboard}}\" and move list \"Returned | Week {weeknumber}\" on board \"{{%homeboard}}\" to position 1 and clear custom field \"homeboard\"","position":{"start":{"line":139,"column":1},"end":{"line":141,"column":1}},"key":"kqdalBWN74"},{"type":"paragraph","position":{"start":{"line":142,"column":1},"end":{"line":142,"column":1}},"children":[{"type":"text","value":"{% endraw %}","position":{"start":{"line":142,"column":1},"end":{"line":142,"column":1}},"key":"NcI3kKiNOO"}],"key":"CQFFAdvwOz"},{"type":"heading","depth":3,"position":{"start":{"line":144,"column":1},"end":{"line":144,"column":1}},"children":[{"type":"text","value":"A global command for project boards","position":{"start":{"line":144,"column":1},"end":{"line":144,"column":1}},"key":"JzQvQAYJqX"}],"identifier":"a-global-command-for-project-boards","label":"A global command for project boards","html_id":"a-global-command-for-project-boards","implicit":true,"key":"nSRD0NYuyW"},{"type":"paragraph","position":{"start":{"line":146,"column":1},"end":{"line":147,"column":1}},"children":[{"type":"text","value":"I also use a global BFT command that moves the cards from each project board to the weekly\nboard when the card is moved to the “Doing” category.","position":{"start":{"line":146,"column":1},"end":{"line":146,"column":1}},"key":"P0H06G1Hg8"}],"key":"yaS5fl1qab"},{"type":"code","lang":"","value":"when a card is added to list \"Doing\" by me, set custom field \"homeboard\" to \"{boardlink}\" and move the card to the top of list \"{boardname}\" on board \"Active\" and move list \"{boardname}\" on board \"Active\" to position 2","position":{"start":{"line":149,"column":1},"end":{"line":151,"column":1}},"key":"JzKDckIgl4"}],"key":"fNhBI6voY2"}],"key":"RWAd33vYQp"},"references":{"cite":{"order":[],"data":{}}},"footer":{"navigation":{"prev":{"title":"Introducing makeitpop, a tool to perceptually warp your data!\"","url":"/blog/2018/makeitpop","group":"2018"},"next":{"title":"I like Rust’s governance structure","url":"/blog/2018/rust-governance","group":"2018"}}},"domain":"http://localhost:3000"}