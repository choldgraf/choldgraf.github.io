xt","value":"Chris Holdgraf","key":"RH1LrQ8bG9"}],"key":"ozoW2dFZgw"}],"urlSource":"/blog/2026/myst-author-experiment","dataUrl":"/blog.2026.myst-author-experiment.json","internal":true,"protocol":"file","key":"zx7l0oR22Q"},{"type":"card","url":"/blog/2025/lock-files","children":[{"type":"cardTitle","children":[{"type":"text","value":"The slow boring of hard boards in open source","key":"h0n1BIYOV6"}],"key":"kItXelMkJI"},{"type":"paragraph","children":[{"type":"text","value":"\n\n\nMax Weber famously wrote that politics is \"a strong and slow boring of hard boards.\" In [Why it took 4 years to get a lock files specification](https://snarky.ca/why-it-took-4-years-to-get-a-lock-files-specification/), Brett Cannon demonstrates how the same principle applies to technical coordination in open source.\n\nPython recently adopted [PEP 751](https://peps.python.org/pep-0751/) for lockfile specification. Doing so","key":"E1ESZnW2fY"}],"key":"YqUCx5wME4"},{"type":"footer","children":[{"type":"strong","children":[{"type":"text","value":"Date: ","key":"smNPYEwlta"}],"key":"VUNtL0Yycs"},{"type":"text","value":"October 21, 2025 | ","key":"PfAWi8cKIm"},{"type":"strong","children":[{"type":"text","value":"Author: ","key":"DnBF3y0Sng"}],"key":"iIfY88BSef"},{"type":"text","value":"Chris Holdgraf","key":"Iibbj1vvR9"}],"key":"iQQvXLINXe"}],"urlSource":"/blog/2025/lock-files","dataUrl":"/blog.2025.lock-files.json","internal":true,"protocol":"file","key":"Nb5L86YHPz"},{"type":"card","url":"/blog/2025/jet-lag","children":[{"type":"cardTitle","children":[{"type":"text","value":"My system for beating jet lag","key":"MolRACwg0o"}],"key":"gA0DevphJK"},{"type":"paragraph","children":[{"type":"text","value":"\n\nI travel internationally a lot, which means I deal with a lot of jet lag. This post is a quick summary of a system I've found helpful, based on [this paper](https://www.frontiersin.org/articles/10.3389/fphys.2019.00927/full).\n\n\nThe basic idea is to shift your body's internal clock by t